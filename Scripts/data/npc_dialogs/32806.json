  "Q10294_SevenSignsToTheMonasteryOfSilence/32806-02.html": {
   "file": "Q10294_SevenSignsToTheMonasteryOfSilence/32806-02.html",
   "quest": 10294,
   "text": "Relic Watcher: One piece of Kaerun's Memoir is stored in all 4 directions. If qualified, you'll know the contents of the book. Place your hand on desk where the memoirs are located in the order of the story. If the order of contents are correct, that desk will illuminate. Of course, if the order is…",
   "header": "Relic Watcher",
   "outcome": "dead-end",
   "links": []
  },
  "Q10294_SevenSignsToTheMonasteryOfSilence/32806-03.html": {
   "file": "Q10294_SevenSignsToTheMonasteryOfSilence/32806-03.html",
   "quest": 10294,
   "text": "Relic Watcher: If you're ready, go in all 4 directions of this room, activate the reading desk with the true piece of Kaerun's Memoir to cancel the seal. When you successfully cancel the seal, you will have the memoir.",
   "header": "Relic Watcher",
   "outcome": "dead-end",
   "links": []
  },
  "Q10294_SevenSignsToTheMonasteryOfSilence/32806-04.html": {
   "file": "Q10294_SevenSignsToTheMonasteryOfSilence/32806-04.html",
   "quest": 10294,
   "text": "Relic Watcher: You haven't proven your qualification. No one leaves until completing the qualification in this room. You should activate the reading desk where the correct memoir is placed to cancel the seal.",
   "header": "Relic Watcher",
   "outcome": "dead-end",
   "links": []
  },
  "Q10294_SevenSignsToTheMonasteryOfSilence/32806-05.html": {
   "file": "Q10294_SevenSignsToTheMonasteryOfSilence/32806-05.html",
   "quest": 10294,
   "text": "Relic Watcher: You are qualified to have Kaerun's Memoir. It is done. Your task here is over.",
