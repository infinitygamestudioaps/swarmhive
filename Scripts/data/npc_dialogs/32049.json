  "Q00617_GatherTheFlames/32049-01.html": {
   "file": "Q00617_GatherTheFlames/32049-01.html",
   "quest": 617,
   "text": "Blacksmith of Wind Rooney: I'm collecting Flames like my brother Vulcan does. Unlike Vulcan, I wander around occasionally, so I was able to get various S-grade Weapon Recipes. If you collect and bring me 1200 Flames, I'll give you a recipe.",
   "header": "Blacksmith of Wind Rooney",
   "when": [
    "state STARTED; NOT (st.getQuestItemsCount(TORCH) >= 1200)"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00901_HowLavasaurusesAreMade/32049-01.htm": {
   "file": "Q00901_HowLavasaurusesAreMade/32049-01.htm",
   "quest": 901,
   "text": "Blacksmith of the Wind Rooney: Do you know about the Lavasauruses? We don't know who made them, but they are believed to contain the power of dragons. If i research the Lavasauruses, I think I would be able to discover the dragon's power...",
   "header": "Blacksmith of the Wind Rooney",
   "when": [
    "state CREATED; (st.getPlayer().getLevel() >= 76)",
    "state COMPLETED; st.isNowAvailable(); (st.getPlayer().getLevel() >= 76)"
   ],
   "links": [
    {
     "text": "\"Can I do anything to help?\"",
