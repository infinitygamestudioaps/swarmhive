  "Q00901_HowLavasaurusesAreMade/32049-05.html": {
   "file": "Q00901_HowLavasaurusesAreMade/32049-05.html",
   "quest": 901,
   "text": "Blacksmith of the Wind Rooney: Looks like you haven't collected all the Lavasaurus fragments yet. You need to bring 10 each of the Lavasaurus head fragments, body fragments, horn fragments and powerstone fragments.",
   "header": "Blacksmith of the Wind Rooney",
   "when": [
