   "outcome": "dead-end",
   "links": []
  },
  "Q00901_HowLavasaurusesAreMade/32049-06.html": {
   "file": "Q00901_HowLavasaurusesAreMade/32049-06.html",
   "quest": 901,
   "text": "Blacksmith of Wind Rooney: Incredible! You managed to get them all! Now lets see if we can discover the secret of the dragons through the Lavasaurus fragments... Hmmm.... If I put this here, and it goes like... no, that doesn't fit. Maybe if I... no... Huh... This might take more time than I though…",
   "header": "Blacksmith of Wind Rooney",
   "when": [
    "state STARTED; cond 2; gotAllQuestItems(st)"
   ],
   "outcome": "dead-end",
   "links": []
  },
