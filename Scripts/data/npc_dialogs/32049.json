  "default/32049.htm": {
   "file": "default/32049.htm",
   "quest": null,
   "text": "Blacksmith of Wind Rooney: I'm Rooney. I came here with my older brother, Vulcan, looking for the ultimate flames in this Forge of the Gods! But I just can't stand in one place like a stone, you know, like Vulcan does! So I'm just stretching my legs a little... Ha!",
   "header": "Blacksmith of Wind Rooney",
