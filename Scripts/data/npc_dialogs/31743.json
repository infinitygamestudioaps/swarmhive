   "file": "Q00242_PossessorOfAPreciousSoul2/31743-02.html",
   "quest": 242,
   "text": "Kassandra: But... the golden princess... the princess...!",
   "header": "Kassandra",
   "links": [
    {
     "text": "\"What's happening to her? What did you see in your dream?\"",
     "bypass": "Quest Q00242_PossessorOfAPreciousSoul2 31743-03.html",
