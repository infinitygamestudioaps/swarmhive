  "Q00242_PossessorOfAPreciousSoul2/31743-03.html": {
   "file": "Q00242_PossessorOfAPreciousSoul2/31743-03.html",
   "quest": 242,
   "text": "Kassandra: They had swords... so many... the princess is trying to escape, but she's caught... No! Don't hurt her! White feathers everywhere...! The princess is crying... she looks so sad... She is taken away!",
   "header": "Kassandra",
   "links": [
    {
     "text": "\"Where to? What do you see around there? Please tell me!\"",
     "bypass": "Quest Q00242_PossessorOfAPreciousSoul2 31743-04.html",
     "kind": "quest-event",
     "script": "Q00242_PossessorOfAPreciousSoul2",
