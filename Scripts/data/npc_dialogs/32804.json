     "event": "32804-06.html",
     "quest": 10294,
     "to": "Q10294_SevenSignsToTheMonasteryOfSilence/32804-06.html"
    }
   ]
  },
  "Q10294_SevenSignsToTheMonasteryOfSilence/32804-06.html": {
   "file": "Q10294_SevenSignsToTheMonasteryOfSilence/32804-06.html",
   "quest": 10294,
   "text": "Relic Watcher: You have chosen the correct memoir. As a final test, I will ask a simple question. If you answer correctly, you will be deemed qualified to take the memoir with you. You won't be able to leave if you don't.",
   "header": "Relic Watcher",
   "links": [
    {
     "text": "I'm ready for the test.",
     "bypass": "Quest Q10294_SevenSignsToTheMonasteryOfSilence 32804-07.html",
     "kind": "quest-event",
     "script": "Q10294_SevenSignsToTheMonasteryOfSilence",
     "event": "32804-07.html",
     "quest": 10294,
     "to": "Q10294_SevenSignsToTheMonasteryOfSilence/32804-07.html"
    }
   ]
  },
