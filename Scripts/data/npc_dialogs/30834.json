  "Q00343_UnderTheShadowOfTheIvoryTower/30834-10.html": {
   "file": "Q00343_UnderTheShadowOfTheIvoryTower/30834-10.html",
   "quest": 343,
   "text": "Magic Trader Cema: Thank you for collecting the samples for us, but we still need more if we are to conduct our experiments successfully. Could you possibly work a little longer for us?",
   "header": "Magic Trader Cema",
   "links": [
    {
     "text": "\"I will continue to work.\"",
     "bypass": "Quest Q00343_UnderTheShadowOfTheIvoryTower 30834-11a.html",
