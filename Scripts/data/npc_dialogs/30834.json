  "Q00343_UnderTheShadowOfTheIvoryTower/30834-09a.html": {
   "file": "Q00343_UnderTheShadowOfTheIvoryTower/30834-09a.html",
   "quest": 343,
   "text": "Magic Trader Cema: The Cursed Bone is essential for a Mystic studying witchcraft. Unlike ordinary Bone Fragments, the Cursed Bone holds a mighty power of darkness within it. Necromancers must have it to create a death spike .",
   "header": "Magic Trader Cema",
   "outcome": "dead-end",
   "links": [
    {
     "text": "Return",
     "bypass": "Quest Q00343_UnderTheShadowOfTheIvoryTower 30834-09.html",
