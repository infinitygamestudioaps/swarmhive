  "Q00343_UnderTheShadowOfTheIvoryTower/30834-11.html": {
   "file": "Q00343_UnderTheShadowOfTheIvoryTower/30834-11.html",
   "quest": 343,
   "text": "Magic Trader Cema: Thank you so much for the hard work you've done for us. I wish you luck in all your future endeavors. Well, goodbye! Until we meet again...",
   "header": "Magic Trader Cema",
   "sets": {
    "exit": true
