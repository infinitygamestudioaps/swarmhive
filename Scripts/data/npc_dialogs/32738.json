  "Q00454_CompletelyLost/32738-05.html": {
   "file": "Q00454_CompletelyLost/32738-05.html",
   "quest": 454,
   "text": "Injured Soldier: Th, thank you. If General Ermian is still alive, I'd bet he's set up camp somewhere safe. But it would be best if it doesn't take too long. As you can see, I've been wounded and it won't be long until I either bleed out or disease takes it toll. If you're prepared, let's depart.",
   "header": "Injured Soldier",
   "when": [
    "state STARTED; memo 1"
   ],
   "links": [
    {
     "text": "Agree.",
     "bypass": "Quest Q00454_CompletelyLost agree1",
     "kind": "quest-event",
