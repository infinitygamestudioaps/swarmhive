  "Q00454_CompletelyLost/32738-05a.html": {
   "file": "Q00454_CompletelyLost/32738-05a.html",
   "quest": 454,
   "text": "Injured Soldier: But adventurer... You cannot carry me all by yourself. Aren't there more of you? We'll never make it just the two of us... get some people to help! I don't have much time.",
   "header": "Injured Soldier",
   "links": [
    {
     "text": "My party is ready, let's go.",
     "bypass": "Quest Q00454_CompletelyLost agree2",
     "kind": "quest-event",
