    }
   ]
  },
  "Q00454_CompletelyLost/32738-01b.htm": {
   "file": "Q00454_CompletelyLost/32738-01b.htm",
   "quest": 454,
   "text": "Injured Soldier: I have already agreed to follow %leader% and his group. They have promised to take me to a safe place. Aren't they wonderful people?",
