  "Q00454_CompletelyLost/32738-03.htm": {
   "file": "Q00454_CompletelyLost/32738-03.htm",
   "quest": 454,
   "text": "Injured Soldier: I... I couldn't ask you for help. It'd be the blind leading the blind (laughs meekly). (This quest is only available to characters level 84 and above.)",
   "header": "Injured Soldier",
