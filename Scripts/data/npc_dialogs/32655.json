  "Q00311_ExpulsionOfEvilSpirits/32655-06.html": {
   "file": "Q00311_ExpulsionOfEvilSpirits/32655-06.html",
   "quest": 311,
   "text": "Cheiren: How did you do? If you present proof of the courage that you displayed, I will give you a fitting reward.",
   "header": "Cheiren",
   "when": [
    "state STARTED; NOT !hasQuestItems(player, SOUL_CORE_CONTAINING_EVIL_SPIRIT, RAGNA_ORCS_AMULET)"
