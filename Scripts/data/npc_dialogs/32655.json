  "default/32655.htm": {
   "file": "default/32655.htm",
   "quest": null,
   "text": "Cheiren: Foolish Baranka! You were exiled because of your mad obsession with evil, and now you have embraced the power of Kasha without hesitation or remorse. There can be no doubt of your fate...",
   "header": "Cheiren",
   "links": [
