  "Q00311_ExpulsionOfEvilSpirits/32655-03.htm": {
   "file": "Q00311_ExpulsionOfEvilSpirits/32655-03.htm",
   "quest": 311,
   "text": "Cheiren: In their arrogance, the Ragna Orcs summoned the power of the evil spirit Kasha. Now Kasha has corrupted them, making them even more vicious and dangerous. Unless we can stop them, all the Orc tribes will be in grave danger... Will you help us?",
   "header": "Cheiren",
   "links": [
    {
     "text": "Say yes.",
     "bypass": "Quest Q00311_ExpulsionOfEvilSpirits 32655-04.htm",
     "kind": "quest-event",
     "script": "Q00311_ExpulsionOfEvilSpirits",
     "event": "32655-04.htm",
