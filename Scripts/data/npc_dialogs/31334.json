  "Q00022_TragedyInVonHellmannForest/31334-12.html": {
   "file": "Q00022_TragedyInVonHellmannForest/31334-12.html",
   "quest": 22,
   "text": "Grand Magister Tifaren: In the name of the Mother, come to me! I, who have mastered the laws of nature, demand that you obey my order! Your spirit shall reside within this vessel. Come!",
   "header": "Grand Magister Tifaren",
   "links": [
    {
     "text": "Wait",
     "bypass": "Quest Q00022_TragedyInVonHellmannForest 31334-13.html",
     "kind": "quest-event",
     "script": "Q00022_TragedyInVonHellmannForest",
     "event": "31334-13.html",
     "quest": 22,
