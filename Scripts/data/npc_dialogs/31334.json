  "Q00022_TragedyInVonHellmannForest/31334-13.html": {
   "file": "Q00022_TragedyInVonHellmannForest/31334-13.html",
   "quest": 22,
   "text": "Grand Magister Tifaren: Success! My work is done. The soul is not stable in this vessel. It won't last long! Find out the rest directly from him before he leaves this realm!",
   "header": "Grand Magister Tifaren",
   "sets": {
    "cond": "6"
   },
   "outcome": "cond",
   "links": []
  },
