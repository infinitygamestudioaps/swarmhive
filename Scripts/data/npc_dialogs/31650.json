  "Q00094_SagaOfTheSoultaker/7-01.htm": {
   "file": "Q00094_SagaOfTheSoultaker/7-01.htm",
   "quest": 94,
   "text": "Tablet of Vision: There are many footprints on the ground and signs of an explosion. Did a fight happen here? These ashes are the same as the ones I found at the last tablet. Could it be Cursed Bone powder? Hmm... The color's not quite right... Someone nearby has the Stone of Commune.",
   "header": "Tablet of Vision",
   "when": [
    "cond 8; !((npcId == 30832) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
