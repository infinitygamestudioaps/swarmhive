  "Q00099_SagaOfTheFortuneSeeker/7-05.htm": {
   "file": "Q00099_SagaOfTheFortuneSeeker/7-05.htm",
   "quest": 99,
   "text": "Tablet of Vision: Hieroglyphics are engraved on the tablet. They emit a dim light, with a mysterious and powerful magic.",
   "header": "Tablet of Vision",
