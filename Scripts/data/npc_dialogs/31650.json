  },
  "Q00099_SagaOfTheFortuneSeeker/7-06.htm": {
   "file": "Q00099_SagaOfTheFortuneSeeker/7-06.htm",
   "quest": 99,
   "text": "Tablet of Vision: The Tablet of Vision becomes overwhelmed by bright lights. While you are holding the stone to work on it, you start to acquire a new sense of knowledge as you hear the voices of thousands reading scriptures in the background. You now realize the truth of the world and yet understa…",
   "header": "Tablet of Vision",
   "outcome": "dead-end",
   "links": []
