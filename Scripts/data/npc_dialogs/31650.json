  "Q00099_SagaOfTheFortuneSeeker/7-07.htm": {
   "file": "Q00099_SagaOfTheFortuneSeeker/7-07.htm",
   "quest": 99,
   "text": "Tablet of Vision: Putting your hands on the tablet, the location of the Stone of Commune again becomes clear. Pamela Aprodia in the Goddard Castle Town has the stone! Go to the town and get it from her.",
   "header": "Tablet of Vision",
