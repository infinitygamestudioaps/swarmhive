  "Q00094_SagaOfTheSoultaker/7-05.htm": {
   "file": "Q00094_SagaOfTheSoultaker/7-05.htm",
   "quest": 94,
   "text": "Tablet of Vision: The footprints, the signs of an explosion and the silver Cursed Bone powder indicate that this was the site of the battle between Hindemith and Iconoclasis! It seems that Hindemith already left on his pilgrimage. The Tablet of Vision is engraved with incomprehensible hieroglyphs.",
   "header": "Tablet of Vision",
   "when": [
    "cond 9; !((npcId == 30832) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
