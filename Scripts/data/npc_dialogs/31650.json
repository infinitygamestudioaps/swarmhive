  "Q00099_SagaOfTheFortuneSeeker/7-02.htm": {
   "file": "Q00099_SagaOfTheFortuneSeeker/7-02.htm",
   "quest": 99,
   "text": "Tablet of Vision: An invisible force pushes you away whenever you go to touch the tablet.",
   "header": "Tablet of Vision",
   "outcome": "dead-end",
   "links": []
  },
  "Q00099_SagaOfTheFortuneSeeker/7-03.htm": {
   "file": "Q00099_SagaOfTheFortuneSeeker/7-03.htm",
   "quest": 99,
   "text": "Tablet of Vision: You must have the Stone of Commune to access this Tablet of Vision. It is being held by an archangel. Defeat Archangel Iconoclasis and take the Stone of Commune.",
   "header": "Tablet of Vision",
   "outcome": "dead-end",
   "links": []
  },
  "Q00099_SagaOfTheFortuneSeeker/7-04.htm": {
