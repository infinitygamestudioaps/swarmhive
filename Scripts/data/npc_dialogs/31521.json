 "pages": {
  "default/31521.htm": {
   "file": "default/31521.htm",
   "quest": null,
   "text": "Chef Jeremy: Humph! Don't you know who I am? You must not get out much! Listen carefully! I'm the greatest chef in the entire hot springs region! Everyone who's tasted my food says it's excellent! Would you care to try it?",
   "header": "Chef Jeremy",
   "links": [
    {
     "text": "Quest",
     "bypass": "npc_%objectId%_Quest",
     "kind": "quest-menu",
     "to": "@questlist"
    }
   ]
  },
  "Q00037_MakeFormalWear/31521-01.html": {
   "file": "Q00037_MakeFormalWear/31521-01.html",
   "quest": 37,
   "text": "Chef Jeremy: What brings you here? Can't you see how busy I am? You're here for the cookies? Let me see the stamp of the person who ordered it. Ah, you're here for Leikar! You're early! They're not ready yet. Don't rush me. I've got an idea, why don't you help me? They'll be ready much quicker..",
   "header": "Chef Jeremy",
   "when": [
    "state STARTED; cond 2"
   ],
   "links": [
    {
     "text": "\"What can I do to help?\"",
     "bypass": "Quest Q00037_MakeFormalWear 31521-02.html",
     "kind": "quest-event",
     "script": "Q00037_MakeFormalWear",
     "event": "31521-02.html",
     "quest": 37,
     "to": "Q00037_MakeFormalWear/31521-02.html",
     "effect": "cond:3"
    }
   ]
  },
  "Q00037_MakeFormalWear/31521-03.html": {
   "file": "Q00037_MakeFormalWear/31521-03.html",
   "quest": 37,
   "text": "Chef Jeremy: Haven't you left yet? You'd better get that cool wine to Information Broker Mist right away!",
   "header": "Chef Jeremy",
   "when": [
    "state STARTED; cond 3"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00037_MakeFormalWear/31521-04.html": {
   "file": "Q00037_MakeFormalWear/31521-04.html",
   "quest": 37,
   "text": "Chef Jeremy: Thank you! What did Mist say when you gave him the wine? Was he upset because it was so late?",
   "header": "Chef Jeremy",
   "when": [
    "state STARTED; cond 4"
   ],
   "links": [
    {
     "text": "\"He didn't seem upset to me.\"",
     "bypass": "Quest Q00037_MakeFormalWear 31521-05.html",
     "kind": "quest-event",
     "script": "Q00037_MakeFormalWear",
     "event": "31521-05.html",
     "quest": 37,
     "to": "Q00037_MakeFormalWear/31521-05.html",
     "effect": "cond:5"
    }
   ]
  },
  "Q00037_MakeFormalWear/31521-06.html": {
   "file": "Q00037_MakeFormalWear/31521-06.html",
   "quest": 37,
   "text": "Chef Jeremy: Did you pack the cookies I made for you? Although they're sealed quite securely, they won't stay fresh forever! Take them to Leikar quickly, before they go stale!",
   "header": "Chef Jeremy",
   "when": [
    "state STARTED; cond 5"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00621_EggDelivery/31521-01.htm": {
   "file": "Q00621_EggDelivery/31521-01.htm",
   "quest": 621,
   "text": "Chef Jeremy: You look like you could use a few extra Adena... Well I'm looking for a helper! You'll earn an honest wage around here, that's for sure! All you have to do is take these steaming hot hard-boiled eggs I just made to my customers. Their names are already written on them. Deliver them qui…",
   "header": "Chef Jeremy",
   "when": [
    "state CREATED; (talker.getLevel() >= MIN_LVL)"
   ],
   "links": [
    {
     "text": "\"I'll deliver your eggs.\"",
     "bypass": "Quest Q00621_EggDelivery 31521-03.htm",
     "kind": "quest-event",
     "script": "Q00621_EggDelivery",
     "event": "31521-03.htm",
     "quest": 621,
     "to": "Q00621_EggDelivery/31521-03.htm",
     "effect": "start"
    }
   ]
  },
  "Q00621_EggDelivery/31521-02.htm": {
   "file": "Q00621_EggDelivery/31521-02.htm",
   "quest": 621,
   "text": "Chef Jeremy: Many dangerous and ferocious beasts lurk these parts. I'd really hate to have to bury another assistant! (Only a character of level 68 or above may undertake this quest.)",
   "header": "Chef Jeremy",
   "when": [
    "state CREATED; NOT (talker.getLevel() >= MIN_LVL)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00621_EggDelivery/31521-04.html": {
   "file": "Q00621_EggDelivery/31521-04.html",
   "quest": 621,
   "text": "Chef Jeremy: What are you waiting for? My customers must be salivating, waiting for my delicious eggs to arrive! Get going!",
   "header": "Chef Jeremy",
   "when": [
    "state STARTED; cond 1"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00621_EggDelivery/31521-05.html": {
   "file": "Q00621_EggDelivery/31521-05.html",
   "quest": 621,
   "text": "Jeremy: OK, OK! Did you finish the delivery?",
   "header": "Jeremy",
   "when": [
    "state STARTED; cond 6; has items 7196"
   ],
   "links": [
    {
     "text": "\"I completed the delivery.\"",
     "bypass": "Quest Q00621_EggDelivery 31521-06.html",
     "kind": "quest-event",
     "script": "Q00621_EggDelivery",
     "event": "31521-06.html",
     "quest": 621,
     "to": "Q00621_EggDelivery/31521-06.html",
     "toAll": [
      "Q00621_EggDelivery/31521-06.html",
      "Q00621_EggDelivery/31521-07.html"
     ],
     "effect": "cond:7"
    }
   ]
  },
  "Q00621_EggDelivery/31521-08.html": {
   "file": "Q00621_EggDelivery/31521-08.html",
   "quest": 621,
   "text": "Jeremy: Hey, what are you doing here? You should've visited Valentine in the Town of Goddard. I don't have any Adena to give you.",
   "header": "Jeremy",
   "when": [
    "state STARTED; cond 7; lacks items 7195"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00622_SpecialtyLiquorDelivery/31521-01.htm": {
   "file": "Q00622_SpecialtyLiquorDelivery/31521-01.htm",
   "quest": 622,
   "text": "Chef Jeremy: You look like you could use a few extra Adena... Well I'm looking for a helper! You'll earn an honest wage around here, that's for sure! All you have to do is take these specialty liquors to my customers. Their names are already written down. Deliver them quickly, and who knows? I migh…",
   "header": "Chef Jeremy",
   "when": [
    "state CREATED; (talker.getLevel() >= MIN_LVL)"
   ],
   "links": [
    {
     "text": "\"I'll deliver your liquor.\"",
     "bypass": "Quest Q00622_SpecialtyLiquorDelivery 31521-03.htm",
     "kind": "quest-event",
     "script": "Q00622_SpecialtyLiquorDelivery",
     "event": "31521-03.htm",
     "quest": 622,
     "to": "Q00622_SpecialtyLiquorDelivery/31521-03.htm",
