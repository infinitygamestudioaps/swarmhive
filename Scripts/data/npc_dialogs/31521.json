  "Q00622_SpecialtyLiquorDelivery/31521-02.htm": {
   "file": "Q00622_SpecialtyLiquorDelivery/31521-02.htm",
   "quest": 622,
   "text": "Chef Jeremy: Many dangerous and ferocious beasts lurk these parts. I'd really hate to have to bury another assistant! (Only a character of level 68 or above may undertake this quest.)",
   "header": "Chef Jeremy",
   "when": [
    "state CREATED; NOT (talker.getLevel() >= MIN_LVL)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00622_SpecialtyLiquorDelivery/31521-04.html": {
   "file": "Q00622_SpecialtyLiquorDelivery/31521-04.html",
   "quest": 622,
   "text": "Chef Jeremy: What are you waiting for? Think my customers who are waiting for my delicious liquor to arrive! Get going!",
   "header": "Chef Jeremy",
   "when": [
    "state STARTED; cond 1"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00622_SpecialtyLiquorDelivery/31521-05.html": {
   "file": "Q00622_SpecialtyLiquorDelivery/31521-05.html",
   "quest": 622,
   "text": "Jeremy: You've come back? Did you finish delivering all the liquor?",
   "header": "Jeremy",
   "when": [
    "state STARTED; cond 6; has items 7198"
   ],
   "links": [
    {
     "text": "\"I completed the delivery.\"",
     "bypass": "Quest Q00622_SpecialtyLiquorDelivery 31521-06.html",
     "kind": "quest-event",
     "script": "Q00622_SpecialtyLiquorDelivery",
     "event": "31521-06.html",
     "quest": 622,
     "to": "Q00622_SpecialtyLiquorDelivery/31521-06.html",
     "toAll": [
