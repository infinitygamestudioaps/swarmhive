  "Q00078_SagaOfTheDoomcryer/2-04.htm": {
   "file": "Q00078_SagaOfTheDoomcryer/2-04.htm",
   "quest": 78,
   "text": "Duda-Mara Totem Spirit: I granted Tarkai's request. If you want to find him, first you must go to the Tablet of Vision.",
