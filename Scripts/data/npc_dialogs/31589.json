  "Q00076_SagaOfTheGrandKhavatari/2-01.htm": {
   "file": "Q00076_SagaOfTheGrandKhavatari/2-01.htm",
   "quest": 76,
   "text": "Duda-Mara Totem Spirit: Heh heh... a young Orc seeking information... I know exactly why you're here! You're trying to find the two Orcs who murdered Khavatari Hubai, aren't you?",
   "header": "Duda-Mara Totem Spirit",
   "when": [
    "cond 1; !((npcId == 31339) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "links": [
    {
     "text": "Yes, I am!",
     "bypass": "Quest Q00076_SagaOfTheGrandKhavatari 2-1",
     "kind": "quest-event",
     "script": "Q00076_SagaOfTheGrandKhavatari",
     "event": "2-1",
     "quest": 76,
     "to": "Q00076_SagaOfTheGrandKhavatari/2-05.htm",
     "effect": "cond:2"
    }
   ]
  },
  "Q00076_SagaOfTheGrandKhavatari/2-02.htm": {
   "file": "Q00076_SagaOfTheGrandKhavatari/2-02.htm",
   "quest": 76,
   "text": "Duda-Mara Totem Spirit: How dare you come here empty-handed! Don't you know who I am? Show the proper respect!",
   "header": "Duda-Mara Totem Spirit",
   "when": [
    "cond 2; !((npcId == 31339) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00076_SagaOfTheGrandKhavatari/2-03.htm": {
   "file": "Q00076_SagaOfTheGrandKhavatari/2-03.htm",
   "quest": 76,
   "text": "Duda-Mara Totem Spirit: Have you brought liquor for the ritual? Well, it's not enough, but it's certainly better than nothing! Give me your hand.",
   "header": "Duda-Mara Totem Spirit",
   "when": [
    "cond 4; !((npcId == 31339) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "links": [
    {
     "text": "\"OK.\"",
