  "Q00078_SagaOfTheDoomcryer/2-02.htm": {
   "file": "Q00078_SagaOfTheDoomcryer/2-02.htm",
   "quest": 78,
   "text": "Duda-Mara Totem Spirit: I guess you haven't met Donath yet. He's the only one who can make Bitter Cold Vodka without using the power of dead spirits.",
