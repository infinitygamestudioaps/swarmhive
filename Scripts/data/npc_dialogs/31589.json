  "Q00078_SagaOfTheDoomcryer/2-01.htm": {
   "file": "Q00078_SagaOfTheDoomcryer/2-01.htm",
   "quest": 78,
   "text": "Duda-Mara Totem Spirit: Ah, yes, Tarkai! That punk told me what happened! Can you become a red-hot live fire that will last throughout the winter , one that can warm everyone up during the long, cold winter?",
   "header": "Duda-Mara Totem Spirit",
   "when": [
    "cond 1; !((npcId == 31336) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "links": [
    {
     "text": "\"I think so.\"",
     "bypass": "Quest Q00078_SagaOfTheDoomcryer 2-1",
     "kind": "quest-event",
     "script": "Q00078_SagaOfTheDoomcryer",
     "event": "2-1",
