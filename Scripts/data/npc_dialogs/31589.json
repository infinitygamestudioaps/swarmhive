  "Q00078_SagaOfTheDoomcryer/2-03.htm": {
   "file": "Q00078_SagaOfTheDoomcryer/2-03.htm",
   "quest": 78,
   "text": "Duda-Mara Totem Spirit: Did you bring the liquor for the ritual? This will do! It's different from the one Kakai has, it should satisfy the spirits. You want to know where Tarkai went? Here, give me your hand.",
   "header": "Duda-Mara Totem Spirit",
   "when": [
