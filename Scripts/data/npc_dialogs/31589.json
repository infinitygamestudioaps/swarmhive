  "Q00076_SagaOfTheGrandKhavatari/2-04.htm": {
   "file": "Q00076_SagaOfTheGrandKhavatari/2-04.htm",
   "quest": 76,
   "text": "Duda-Mara Totem Spirit: The time has come for your last journey of training as a tyrant. Go to the Tablet of Vision, my child.",
