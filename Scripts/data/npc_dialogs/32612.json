 "pages": {
  "merchant/32612.htm": {
   "file": "merchant/32612.htm",
   "quest": null,
   "text": "Weaver Olf Adams: Welcome! I am Olf Adams, a weaver of Rauren Olf Company, the best weaving guild in Aden. Our products are confortable, practical and yet also luxurious. Rauren Olf will never let you down. Now, what are you looking for?",
   "header": "Weaver Olf Adams",
   "links": [
    {
     "text": "Buy a belt.",
     "bypass": "npc_%objectId%_exc_multisell 326100001",
     "kind": "multisell"
    },
    {
     "text": "Order a custom-tailored cloak.",
     "bypass": "npc_%objectId%_multisell 326100002",
     "kind": "multisell"
    },
    {
     "text": "Remove the seal on a pin, pouch, clip or accessory.",
     "bypass": "npc_%objectId%_Quest WeaverOlf",
     "kind": "quest",
     "script": "WeaverOlf",
     "to": "ai/npc/WeaverOlf/32612-1.htm"
    },
    {
     "text": "Quest",
     "bypass": "npc_%objectId%_Quest",
     "kind": "quest-menu",
     "to": "@questlist"
    }
   ]
  },
  "Q10501_ZakenEmbroideredSoulCloak/32612-02.html": {
   "file": "Q10501_ZakenEmbroideredSoulCloak/32612-02.html",
   "quest": 10501,
   "text": "Weaver Olf Adams: I'm sorry, but you're not ready to take this on. (Only characters of level 78 or above can take on this quest.)",
   "header": "Weaver Olf Adams",
   "when": [
    "state CREATED; (player.getLevel() < MIN_LEVEL)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q10501_ZakenEmbroideredSoulCloak/32612-01.htm": {
   "file": "Q10501_ZakenEmbroideredSoulCloak/32612-01.htm",
   "quest": 10501,
   "text": "Weaver Olf Adams: Recently, our weavers' guild learned how to imbed the souls of monsters into the clothes that we make. This method allows us to make clothes that are far superior, and gives the wearer a monster-like appearance. If you can collect souls of boss monsters, I can make you a new cloak…",
   "header": "Weaver Olf Adams",
   "when": [
    "state CREATED; NOT (player.getLevel() < MIN_LEVEL)"
   ],
   "links": [
    {
     "text": "\"Of course!\"",
     "bypass": "Quest Q10501_ZakenEmbroideredSoulCloak 32612-04.html",
     "kind": "quest-event",
     "script": "Q10501_ZakenEmbroideredSoulCloak",
     "event": "32612-04.html",
     "quest": 10501,
     "to": "Q10501_ZakenEmbroideredSoulCloak/32612-04.html",
     "effect": "start"
    }
   ]
  },
  "Q10501_ZakenEmbroideredSoulCloak/32612-05.html": {
   "file": "Q10501_ZakenEmbroideredSoulCloak/32612-05.html",
   "quest": 10501,
   "text": "Weaver Olf Adams: There still aren't enough soul fragments here. Every time you capture Zaken (top) , you will receive Zaken Soul Fragments . Please bring back 20 of them!",
   "header": "Weaver Olf Adams",
   "when": [
    "state STARTED; cond 1"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q10501_ZakenEmbroideredSoulCloak/32612-06.html": {
   "file": "Q10501_ZakenEmbroideredSoulCloak/32612-06.html",
   "quest": 10501,
   "text": "Weaver Olf Adams: You've finally collected all the soul fragments! Here is the cloak as promised!",
   "header": "Weaver Olf Adams",
