  "Q00082_SagaOfTheSagittarius/11-01.htm": {
   "file": "Q00082_SagaOfTheSagittarius/11-01.htm",
   "quest": 82,
   "text": "Pilgrim of Darkness: You're looking for a man who stole a bow, eh? I saw someone who fits that description not very long ago! I spent a day in the woods with him! We must have talked about everything! He seemed like a nice guy to me... Did he do anything serious?",
   "header": "Pilgrim of Darkness",
   "when": [
    "cond 14; !((npcId == 30702) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "links": [
    {
     "text": "\"He's a thief!\"",
