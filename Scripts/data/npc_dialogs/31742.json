  "Q00241_PossessorOfAPreciousSoul1/31742-01.html": {
   "file": "Q00241_PossessorOfAPreciousSoul1/31742-01.html",
   "quest": 241,
   "text": "Virgil: I've been waiting for you. You've undertaken the trial as the ranking guild member, and helped Reorin save his wife's soul and restore his reputation. You don't have to live the life of a criminal anymore. Drinking Mimir's Elixir allows you to create your own destiny. It was no coincidence …",
   "header": "Virgil",
   "when": [
    "cond 11"
   ],
   "links": [
    {
     "text": "\"What dream?\"",
     "bypass": "Quest Q00241_PossessorOfAPreciousSoul1 31742-02.html",
     "kind": "quest-event",
     "script": "Q00241_PossessorOfAPreciousSoul1",
