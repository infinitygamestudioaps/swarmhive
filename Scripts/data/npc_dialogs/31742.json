  },
  "Q00241_PossessorOfAPreciousSoul1/31742-03.html": {
   "file": "Q00241_PossessorOfAPreciousSoul1/31742-03.html",
   "quest": 241,
   "text": "Virgil: Kassandra's nightmare has some important details concerning you. Ogmar knows the story, talk to him.",
   "header": "Virgil",
