   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00241_PossessorOfAPreciousSoul1/31742-04.html": {
   "file": "Q00241_PossessorOfAPreciousSoul1/31742-04.html",
   "quest": 241,
   "text": "Virgil: I knew you could do it! She looks better already. Thank you. I don't know how to tell you, but there's someone who worships the Lady of the Lake who wants to see you. Do you want to meet her?",
   "header": "Virgil",
   "when": [
    "cond 17"
   ],
   "links": [
    {
     "text": "\"Yes.\"",
     "bypass": "Quest Q00241_PossessorOfAPreciousSoul1 31742-05.html",
