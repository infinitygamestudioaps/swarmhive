    }
   ]
  },
  "Q00644_GraveRobberAnnihilation/32017-07.html": {
   "file": "Q00644_GraveRobberAnnihilation/32017-07.html",
   "quest": 644,
   "text": "Karuda: Here, and may Pa'agrio bless and protect you! Perhaps we will meet again, if it is His will.",
   "header": "Karuda",
   "outcome": "dead-end",
   "links": []
  },
  "Q00645_GhostsOfBatur/32017-03.htm": {
   "file": "Q00645_GhostsOfBatur/32017-03.htm",
   "quest": 645,
   "text": "Karuda: Go to the Crypts of Disgrace and defeat the Contaminated Batur Warriors and Contaminated Batur Commanders , as well as the Contaminated Morek Warriors . When you have defeated them, you will obtain Cursed Burial Items . Bring those to me and you will be richly rewarded!",
   "header": "Karuda",
   "sets": {
    "start": true
   },
   "outcome": "start",
   "links": [
    {
     "text": "\"I'll be back soon.\"",
     "bypass": "Quest Q00645_GhostsOfBatur 32017-08.html",
     "kind": "quest-event",
     "script": "Q00645_GhostsOfBatur",
     "event": "32017-08.html",
     "quest": 645,
     "to": "Q00645_GhostsOfBatur/32017-08.html"
    },
    {
     "text": "\"What kind of rewards?\"",
     "bypass": "Quest Q00645_GhostsOfBatur 32017-06.html",
     "kind": "quest-event",
     "script": "Q00645_GhostsOfBatur",
     "event": "32017-06.html",
     "quest": 645,
     "to": "Q00645_GhostsOfBatur/32017-06.html"
    }
   ]
  },
  "Q00645_GhostsOfBatur/32017-06.html": {
   "file": "Q00645_GhostsOfBatur/32017-06.html",
   "quest": 645,
   "text": "Karuda: You can earn the following rewards: S80 weapon recipe - Requires 500 Cursed Grave Goods Leonard - Requires 8 Cursed Grave Goods Adamantine - Requires 15 Cursed Grave Goods Orichalcum - Requires 12 Cursed Grave Goods Remember, I'm counting on you!",
   "header": "Karuda",
   "outcome": "dead-end",
   "links": []
  },
  "Q00645_GhostsOfBatur/32017-08.html": {
   "file": "Q00645_GhostsOfBatur/32017-08.html",
   "quest": 645,
   "text": "Karuda: Please keep up the good work for the safety of this area. I'm counting on you!",
   "header": "Karuda",
   "outcome": "dead-end",
   "links": []
  },
  "Q00645_GhostsOfBatur/32017-09.html": {
   "file": "Q00645_GhostsOfBatur/32017-09.html",
   "quest": 645,
   "text": "Karuda: Well, if that's your decision, I won't try to force you. Goodbye!",
   "header": "Karuda",
   "sets": {
    "exit": true
   },
   "outcome": "end",
   "links": []
  },
