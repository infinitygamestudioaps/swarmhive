  "Q00023_LidiasHeart/31526-04.html": {
   "file": "Q00023_LidiasHeart/31526-04.html",
   "quest": 23,
   "text": "Broken Bookshelf: The hair pin is a type once used by aristocratic ladies. It's engraved with the image of a Moon Face Flower, and was probably used by a unattached young lady.",
   "header": "Broken Bookshelf",
   "links": [
    {
     "text": "\"I wonder what that design means?\"",
     "bypass": "Quest Q00023_LidiasHeart 31526-05.html",
     "kind": "quest-event",
     "script": "Q00023_LidiasHeart",
     "event": "31526-05.html",
