   "quest": 23,
   "text": "Broken Bookshelf: When you cut the string, it falls to the floor and you hear a faint sigh. Shall you read the book?",
   "header": "Broken Bookshelf",
   "links": [
    {
     "text": "Read the book.",
     "bypass": "Quest Q00023_LidiasHeart 31526-09.html",
