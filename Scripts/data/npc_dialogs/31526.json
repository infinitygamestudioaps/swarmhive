    }
   ]
  },
  "Q00023_LidiasHeart/31526-10.html": {
   "file": "Q00023_LidiasHeart/31526-10.html",
   "quest": 23,
   "text": "Broken Bookshelf: It's a journal that belonged to Lidia von Hellmann. It probably has a lot of useful information in it!",
   "header": "Broken Bookshelf",
   "links": [
