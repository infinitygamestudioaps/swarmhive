    }
   ]
  },
  "Q00023_LidiasHeart/31526-05.html": {
   "file": "Q00023_LidiasHeart/31526-05.html",
   "quest": 23,
   "text": "Broken Bookshelf: According to legend, the Moon Face Flower only blooms on moonlit nights. It's very shy, and shows its face only to its future husband. This legend made it quite popular among young, single, aristocratic ladies. I wonder who might have owned this one?",
   "header": "Broken Bookshelf",
   "links": [
    {
     "text": "Take the hairpin.",
     "bypass": "Quest Q00023_LidiasHeart 31526-06.html",
     "kind": "quest-event",
     "script": "Q00023_LidiasHeart",
     "event": "31526-06.html",
     "quest": 23,
     "to": "Q00023_LidiasHeart/31526-06.html",
     "effect": "cond:4"
    }
   ]
  },
