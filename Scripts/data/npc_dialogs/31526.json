  "Q00023_LidiasHeart/31526-09.html": {
   "file": "Q00023_LidiasHeart/31526-09.html",
   "quest": 23,
   "text": "Broken Bookshelf: \"Month of Shilen, 15th day. Lately, Father spends all his days with Nidrah! He doesn't take care of the manor like he should. What makes him so angry? What's this?!",
   "header": "Broken Bookshelf",
   "links": [
    {
     "text": "\"It's Lidia's Diary!\"",
     "bypass": "Quest Q00023_LidiasHeart 31526-10.html",
     "kind": "quest-event",
     "script": "Q00023_LidiasHeart",
     "event": "31526-10.html",
     "quest": 23,
