 "pages": {
  "default/31529.htm": {
   "file": "default/31529.htm",
   "quest": null,
   "text": "Ghost of an Adventurer: I can't even... sigh... Do other dead Humans have this problem?",
   "header": "Ghost of an Adventurer",
   "links": [
    {
     "text": "Quest",
     "bypass": "npc_%objectId%_Quest",
