    }
   ]
  },
  "Q00343_UnderTheShadowOfTheIvoryTower/30934-04.html": {
   "file": "Q00343_UnderTheShadowOfTheIvoryTower/30934-04.html",
   "quest": 343,
   "text": "Collector Marsha: Good to see you again! Would you like to play the rock-paper-scissors game? Remember the rules? The winner gets 10 Nebulite Orbs from the loser! What a great way to save an afternoon's work!",
   "header": "Collector Marsha",
   "when": [
    "state STARTED; !qs.getMemoStateEx(1) == 0"
   ],
   "links": [
    {
     "text": "Play the rock paper scissors game.",
     "bypass": "Quest Q00343_UnderTheShadowOfTheIvoryTower 30934-05.html",
     "kind": "quest-event",
     "script": "Q00343_UnderTheShadowOfTheIvoryTower",
     "event": "30934-05.html",
     "quest": 343,
     "to": "Q00343_UnderTheShadowOfTheIvoryTower/30934-05.html",
     "toAll": [
      "Q00343_UnderTheShadowOfTheIvoryTower/30934-05.html",
