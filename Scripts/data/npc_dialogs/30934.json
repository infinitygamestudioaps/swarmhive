 "pages": {
  "default/30934.htm": {
   "file": "default/30934.htm",
   "quest": null,
   "text": "Collector Marsha: Merciful heavens, you startled me! How did you sneak up on me like that?! Anyway, it's nice to meet you! I am Collector Marsha, an expert in exotic substances. I am here searching for Starstones. I had no idea this place was so dangerous! Earlier I was nearly killed, and now I fea…",
   "header": "Collector Marsha",
   "links": [
    {
     "text": "Ask about Starstones",
     "bypass": "npc_%objectId%_Chat 1",
     "kind": "page",
     "to": "default/30934-1.htm"
    },
    {
     "text": "\"Tell me about your brother.\"",
     "bypass": "npc_%objectId%_Chat 2",
     "kind": "page",
     "to": "default/30934-2.htm"
    },
    {
     "text": "Quest",
     "bypass": "npc_%objectId%_Quest",
     "kind": "quest-menu",
     "to": "@questlist"
    }
   ]
  },
  "default/30934-1.htm": {
   "file": "default/30934-1.htm",
   "quest": null,
   "text": "Collector Marsha: Starstones... known amongst the wizards as nebulite... A very rare mineral indeed! It comes to us upon meteorites. It was much more common in ancient times. Titans used it as a power source for their fantastic machines.",
   "header": "Collector Marsha",
   "outcome": "dead-end",
   "links": [
    {
     "text": "Return",
     "bypass": "npc_%objectId%_Chat 0",
     "kind": "page",
     "to": "default/30934.htm"
    }
   ]
  },
  "default/30934-2.htm": {
   "file": "default/30934-2.htm",
   "quest": null,
   "text": "Collector Marsha: My older brother Trumpin is also a collector. He is very diligent and capable, although he does have a weakness for games of chance. I have watched him gamble away all his savings. Actually I saw him not too long ago. We were running away from monster eyes and became separated. He…",
   "header": "Collector Marsha",
   "outcome": "dead-end",
   "links": [
    {
     "text": "Return",
     "bypass": "npc_%objectId%_Chat 0",
     "kind": "page",
     "to": "default/30934.htm"
    }
   ]
  },
  "Q00343_UnderTheShadowOfTheIvoryTower/30934-03.html": {
   "file": "Q00343_UnderTheShadowOfTheIvoryTower/30934-03.html",
   "quest": 343,
   "text": "Collector Marsha: Magic Trader Cema has requested that I collect Starstones, also known as Nebulite. Ah, so you are also looking for Starstones! Would you like to play a simple game of chance? Surely you know how to play rock-paper-scissors!? The winner will get to keep all the Nebulite Orbs we hav…",
   "header": "Collector Marsha",
   "when": [
    "state STARTED; qs.getMemoStateEx(1) == 0"
   ],
   "links": [
    {
     "text": "Play rock-paper-scissors.",
     "bypass": "Quest Q00343_UnderTheShadowOfTheIvoryTower 30934-05.html",
     "kind": "quest-event",
     "script": "Q00343_UnderTheShadowOfTheIvoryTower",
     "event": "30934-05.html",
     "quest": 343,
     "to": "Q00343_UnderTheShadowOfTheIvoryTower/30934-05.html",
     "toAll": [
      "Q00343_UnderTheShadowOfTheIvoryTower/30934-05.html",
      "Q00343_UnderTheShadowOfTheIvoryTower/30934-06.html",
      "Q00343_UnderTheShadowOfTheIvoryTower/30934-07.html"
     ],
     "effect": "cond:2"
    },
    {
     "text": "Quit",
     "bypass": "Quest Q00343_UnderTheShadowOfTheIvoryTower 30934-03a.html",
     "kind": "quest-event",
     "script": "Q00343_UnderTheShadowOfTheIvoryTower",
     "event": "30934-03a.html",
     "quest": 343,
