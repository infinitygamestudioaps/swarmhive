      "Q00343_UnderTheShadowOfTheIvoryTower/30934-07.html"
     ],
     "effect": "cond:2"
    },
    {
     "text": "Quit",
     "bypass": "Quest Q00343_UnderTheShadowOfTheIvoryTower 30934-03a.html",
     "kind": "quest-event",
     "script": "Q00343_UnderTheShadowOfTheIvoryTower",
     "event": "30934-03a.html",
     "quest": 343,
     "to": "Q00343_UnderTheShadowOfTheIvoryTower/30934-03a.html"
    }
   ]
  },
  "Q00343_UnderTheShadowOfTheIvoryTower/30934-03a.html": {
   "file": "Q00343_UnderTheShadowOfTheIvoryTower/30934-03a.html",
   "quest": 343,
   "text": "Collector Marsha: Fine, I understand... The game is probably too complicated for you anyway... If you change your mind, come back and we will play!",
   "header": "Collector Marsha",
   "outcome": "dead-end",
   "links": []
  },
  "Q00343_UnderTheShadowOfTheIvoryTower/30934-05.html": {
   "file": "Q00343_UnderTheShadowOfTheIvoryTower/30934-05.html",
   "quest": 343,
   "text": "Collector Marsha: One more round, what do you say? Uh oh, what is this? I'm out of Nebulite Orbs! Come back when I've had time to gather some more.",
   "header": "Collector Marsha",
   "sets": {
    "cond": "2"
   },
   "outcome": "cond",
   "links": []
  },
  "Q00343_UnderTheShadowOfTheIvoryTower/30934-06.html": {
   "file": "Q00343_UnderTheShadowOfTheIvoryTower/30934-06.html",
   "quest": 343,
   "text": "Collector Marsha: You need to have at least ten Nebulite Orbs to play the rock-paper-scissors game! Go and get some more orbs and come back to see me, I'm always ready to play!",
   "header": "Collector Marsha",
   "outcome": "dead-end",
   "links": []
  },
  "Q00343_UnderTheShadowOfTheIvoryTower/30934-07.html": {
   "file": "Q00343_UnderTheShadowOfTheIvoryTower/30934-07.html",
   "quest": 343,
   "text": "Collector Marsha: First, you should place 10 Nebulite Orbs as a bet! I'll bet the same! The winner takes all! Understand? Shall we begin?",
   "header": "Collector Marsha",
   "links": [
    {
