  "Q00614_SlayTheEnemyCommanderVarka/31377-02.htm": {
   "file": "Q00614_SlayTheEnemyCommanderVarka/31377-02.htm",
   "quest": 614,
   "text": "Chief Ashas Varka Durai: The time has not yet come. If we are to achieve victory, we must have patience. A superior strategist waits patiently for just the right moment... and when that moment comes... he strikes! (Only characters who possess the mark of Varka's friend - 4th level can undertake thi…",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state CREATED; (player.getLevel() >= MIN_LEVEL); NOT (st.hasQuestItems(VARKA_ALLIANCE_FOUR))"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00614_SlayTheEnemyCommanderVarka/31377-03.htm": {
   "file": "Q00614_SlayTheEnemyCommanderVarka/31377-03.htm",
   "quest": 614,
   "text": "Chief Ashas Varka Durai: You're not quite ready. Go improve your skills! (This quest may only be undertaken by characters of level 75 or above.)",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state CREATED; NOT (player.getLevel() >= MIN_LEVEL)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00614_SlayTheEnemyCommanderVarka/31377-05.html": {
   "file": "Q00614_SlayTheEnemyCommanderVarka/31377-05.html",
   "quest": 614,
   "text": "Chief Ashas Varka Durai: Dear friend of Varka, have you brought the Head of Tayre, the commander of the Ketras?",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state STARTED; (st.isCond(2) && st.hasQuestItems(TAYR_HEAD))"
   ],
   "links": [
    {
     "text": "\"Here's Tayre's head.\"",
     "bypass": "Quest Q00614_SlayTheEnemyCommanderVarka 31377-07.html",
     "kind": "quest-event",
     "script": "Q00614_SlayTheEnemyCommanderVarka",
     "event": "31377-07.html",
     "quest": 614,
     "to": "Q00614_SlayTheEnemyCommanderVarka/31377-07.html",
     "effect": "reward"
    }
