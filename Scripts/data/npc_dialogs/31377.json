 "pages": {
  "ai/npc/VarkaSilenosSupport/31377-friend.html": {
   "file": "ai/npc/VarkaSilenosSupport/31377-friend.html",
   "quest": null,
   "text": "Elder Ashas Varka Durai: Welcome, my friend! I'm Ashas Varka Durai, an elder of the Varka tribe. To defend the land that was promised to us, we're at war with the arrogant Ketra Orcs. You've helped us to significantly damage them. They've proven to be much more formidable than we thought. We've rea…",
   "header": "Elder Ashas Varka Durai",
   "when": [
    "(AllianceLevel < 0)"
   ],
   "links": [
    {
     "text": "Quest",
     "bypass": "npc_%objectId%_Quest",
     "kind": "quest-menu",
     "to": "@questlist"
    }
   ]
  },
  "ai/npc/VarkaSilenosSupport/31377-no.html": {
   "file": "ai/npc/VarkaSilenosSupport/31377-no.html",
   "quest": null,
   "text": "Elder Ashas Varka Durai: Hold it right there, stranger! Unfriendly visitors aren't welcome in this land! Traveler of the west wind! If you expect to win our trust, you must first visit Varka's messenger Naran Ashanuk . He'll tell you what you must do.",
   "header": "Elder Ashas Varka Durai",
   "when": [
    "NOT (AllianceLevel < 0)"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00612_BattleAgainstKetraOrcs/31377-01.htm": {
   "file": "Q00612_BattleAgainstKetraOrcs/31377-01.htm",
   "quest": 612,
   "text": "Chief Ashas Varka Durai: Our ancient battle against the Ketra Orcs continues to this very day. We must defeat them once and for all and reclaim our promised land! Who will join our fight?",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state CREATED; (player.getLevel() >= MIN_LEVEL)"
   ],
   "links": [
    {
     "text": "\"I will fight the Ketra Orcs.\"",
     "bypass": "Quest Q00612_BattleAgainstKetraOrcs 31377-03.htm",
     "kind": "quest-event",
     "script": "Q00612_BattleAgainstKetraOrcs",
     "event": "31377-03.htm",
     "quest": 612,
     "to": "Q00612_BattleAgainstKetraOrcs/31377-03.htm",
     "effect": "start"
    }
   ]
  },
  "Q00612_BattleAgainstKetraOrcs/31377-02.htm": {
   "file": "Q00612_BattleAgainstKetraOrcs/31377-02.htm",
   "quest": 612,
   "text": "Chief Ashas Varka Durai: Your courage is admirable, but you're not quite ready for the fight. Improve your skills and come back. (This quest may only be undertaken by characters of level 74 or above.)",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state CREATED; NOT (player.getLevel() >= MIN_LEVEL)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00612_BattleAgainstKetraOrcs/31377-04.html": {
   "file": "Q00612_BattleAgainstKetraOrcs/31377-04.html",
   "quest": 612,
   "text": "Chief Ashas Varka Durai My colleague, have you slaughtered many enemies, those barbarian Orcs of Ketra? Did you place the shadow of humiliation and disgrace upon them?",
   "when": [
    "state STARTED; (st.hasQuestItems(MOLAR))"
   ],
   "links": [
    {
     "text": "\"I will come back after killing more enemies.\"",
     "bypass": "Quest Q00612_BattleAgainstKetraOrcs 31377-06.html",
     "kind": "quest-event",
     "script": "Q00612_BattleAgainstKetraOrcs",
     "event": "31377-06.html",
     "quest": 612,
     "to": "Q00612_BattleAgainstKetraOrcs/31377-06.html"
    },
    {
     "text": "\"I brought 100 molars for a start.\"",
     "bypass": "Quest Q00612_BattleAgainstKetraOrcs 31377-07.html",
     "kind": "quest-event",
     "script": "Q00612_BattleAgainstKetraOrcs",
     "event": "31377-07.html",
     "quest": 612,
     "to": "Q00612_BattleAgainstKetraOrcs/31377-07.html",
     "toAll": [
      "Q00612_BattleAgainstKetraOrcs/31377-07.html",
      "Q00612_BattleAgainstKetraOrcs/31377-08.html"
     ],
     "effect": "reward"
    },
    {
     "text": "\"I'm going to quit fighting.\"",
     "bypass": "Quest Q00612_BattleAgainstKetraOrcs 31377-09.html",
     "kind": "quest-event",
     "script": "Q00612_BattleAgainstKetraOrcs",
     "event": "31377-09.html",
     "quest": 612,
     "to": "Q00612_BattleAgainstKetraOrcs/31377-09.html"
    }
   ]
  },
  "Q00612_BattleAgainstKetraOrcs/31377-05.html": {
   "file": "Q00612_BattleAgainstKetraOrcs/31377-05.html",
   "quest": 612,
   "text": "Chief Ashas Varka Durai: Drive the Ketra Orcs from the promised land of the Varka! Don't let a single invader escape! Kill them all!",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state STARTED; NOT (st.hasQuestItems(MOLAR))"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00613_ProveYourCourageVarka/31377-01.htm": {
   "file": "Q00613_ProveYourCourageVarka/31377-01.htm",
   "quest": 613,
   "text": "Chief Ashas Varka Durai: Have you heard of Hekaton, the hero of those despicable Ketra Orcs? Countless brave Varka soldiers have fallen before his axe, and I can still hear his howls of victory! We Varka can no longer ignore his atrocities! I seek a brave warrior to execute this scurvy dog! Will yo…",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state CREATED; (player.getLevel() >= MIN_LEVEL); (st.hasQuestItems(VARKA_ALLIANCE_THREE))"
   ],
   "links": [
    {
     "text": "\"I'll kill Hekaton.\"",
     "bypass": "Quest Q00613_ProveYourCourageVarka 31377-04.htm",
     "kind": "quest-event",
     "script": "Q00613_ProveYourCourageVarka",
     "event": "31377-04.htm",
     "quest": 613,
     "to": "Q00613_ProveYourCourageVarka/31377-04.htm",
     "effect": "start"
    }
   ]
  },
  "Q00613_ProveYourCourageVarka/31377-02.htm": {
   "file": "Q00613_ProveYourCourageVarka/31377-02.htm",
   "quest": 613,
   "text": "Chief Ashas Varka Durai: I must find a worthy fighter who can defeat Hekaton of the Ketra Orcs! Sadly, I don't think you're up to the task! Sigh... It seems like they're all too young or too old... (Only a character who possesses the mark of Varka's friend - 3rd level can undertake this quest.)",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state CREATED; (player.getLevel() >= MIN_LEVEL); NOT (st.hasQuestItems(VARKA_ALLIANCE_THREE))"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00613_ProveYourCourageVarka/31377-03.htm": {
   "file": "Q00613_ProveYourCourageVarka/31377-03.htm",
   "quest": 613,
   "text": "Chief Ashas Varka Durai: You're not ready yet, my child! (Only a character of level 75 or above may undertake this quest.)",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state CREATED; NOT (player.getLevel() >= MIN_LEVEL)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00613_ProveYourCourageVarka/31377-05.html": {
   "file": "Q00613_ProveYourCourageVarka/31377-05.html",
   "quest": 613,
   "text": "Chief Ashas Varka Durai: Have you brought the head of the hero of the Ketra Orcs?",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state STARTED; (st.isCond(2) && st.hasQuestItems(HEKATON_HEAD))"
   ],
   "links": [
    {
     "text": "\"Here is Hekaton's head.\"",
     "bypass": "Quest Q00613_ProveYourCourageVarka 31377-07.html",
