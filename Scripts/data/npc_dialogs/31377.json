  "Q00613_ProveYourCourageVarka/31377-06.html": {
   "file": "Q00613_ProveYourCourageVarka/31377-06.html",
   "quest": 613,
   "text": "Chief Ashas Varka Durai: Prove yourself! Kill Hekaton and cut off his head!",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state STARTED; NOT (st.isCond(2) && st.hasQuestItems(HEKATON_HEAD))"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00614_SlayTheEnemyCommanderVarka/31377-01.htm": {
   "file": "Q00614_SlayTheEnemyCommanderVarka/31377-01.htm",
   "quest": 614,
   "text": "Chief Ashas Varka Durai: The time has come for the Varka to strike back! If we are to prevail, we must first slay the commander of Ketra Orcs! Who will step forward to kill this beast?",
   "header": "Chief Ashas Varka Durai",
   "when": [
    "state CREATED; (player.getLevel() >= MIN_LEVEL); (st.hasQuestItems(VARKA_ALLIANCE_FOUR))"
   ],
   "links": [
    {
     "text": "I'll do it!",
     "bypass": "Quest Q00614_SlayTheEnemyCommanderVarka 31377-04.htm",
     "kind": "quest-event",
     "script": "Q00614_SlayTheEnemyCommanderVarka",
     "event": "31377-04.htm",
     "quest": 614,
     "to": "Q00614_SlayTheEnemyCommanderVarka/31377-04.htm",
