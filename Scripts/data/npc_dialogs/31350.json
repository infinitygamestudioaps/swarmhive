  "Q00639_GuardiansOfTheHolyGrail/31350-01.html": {
   "file": "Q00639_GuardiansOfTheHolyGrail/31350-01.html",
   "quest": 639,
   "text": "Priest Dominic: Ahhh... that mission has been.. satisfied. It's time for a new mission.",
