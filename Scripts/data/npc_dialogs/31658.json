   "file": "Q00079_SagaOfTheAdventurer/10-02.htm",
   "quest": 79,
   "text": "Tablet of Vision: You feel a huge surge of energy.",
   "header": "Tablet of Vision",
   "outcome": "dead-end",
   "links": []
  },
  "Q00079_SagaOfTheAdventurer/10-03.htm": {
   "file": "Q00079_SagaOfTheAdventurer/10-03.htm",
   "quest": 79,
   "text": "Tablet of Vision: The tablet is still and dark. Speak with the Hero.",
