  "Q00091_SagaOfTheArcanaLord/10-07.htm": {
   "file": "Q00091_SagaOfTheArcanaLord/10-07.htm",
   "quest": 91,
   "text": "Tablet of Vision: Nothing happens any more even when you lay your hands on the tablet. Now that you have finished your pilgrimage of the tablet, return to Ivory Tower and see Head Summoner Kinsley .",
   "header": "Tablet of Vision",
   "when": [
    "cond 19; !((npcId == 31605) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "outcome": "refusal",
   "links": []
  },
