  "Q00079_SagaOfTheAdventurer/10-06.htm": {
   "file": "Q00079_SagaOfTheAdventurer/10-06.htm",
   "quest": 79,
   "text": "Tablet of Vision: A familiar feeling rushes through your body. And then when it seems unbearable, a new vision appears... All the pleasure, pain, anger and love ever felt by all the previous challengers of this power courses at once through your veins! The emotions rush over you like a waterfall, a…",
   "header": "Tablet of Vision",
   "outcome": "dead-end",
   "links": []
  },
