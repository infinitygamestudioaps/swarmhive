   "links": []
  },
  "Q00075_SagaOfTheTitan/10-06.htm": {
   "file": "Q00075_SagaOfTheTitan/10-06.htm",
   "quest": 75,
   "text": "Tablet of Vision: Countless thoughts beyond comprehension sear painfully into your brain. I can hear laughter as though coming from the back of my head. A man's voice states, \"Another hero is born.\" A lady, dressed in blue, responds, \"No, he has much to learn and experience. I'm afraid I can't give…",
   "header": "Tablet of Vision",
   "outcome": "refusal",
   "links": []
  },
