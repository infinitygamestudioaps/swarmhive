  "Q00089_SagaOfTheMysticMuse/10-07.htm": {
   "file": "Q00089_SagaOfTheMysticMuse/10-07.htm",
   "quest": 89,
   "text": "Tablet of Vision: Further communion with this tablet would be futile. Communion with the six Tablets of Vision is complete. Now return to Grand Magister Arkenias .",
   "header": "Tablet of Vision",
   "when": [
    "cond 19; !((npcId == 30174) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00091_SagaOfTheArcanaLord/10-01.htm": {
   "file": "Q00091_SagaOfTheArcanaLord/10-01.htm",
   "quest": 91,
   "text": "Tablet of Vision: You can feel the presence of the Stone of Commune near the tablet. You feel you can find out its exact location if you lay your hands on the tablet.",
   "header": "Tablet of Vision",
   "when": [
    "cond 17; !((npcId == 31605) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
