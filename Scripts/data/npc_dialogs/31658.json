   "outcome": "dead-end",
   "links": []
  },
  "Q00098_SagaOfTheShillienSaint/10-06.htm": {
   "file": "Q00098_SagaOfTheShillienSaint/10-06.htm",
   "quest": 98,
   "text": "Tablet of Vision: Forbidden knowledge begins to flow into you without pain. Go and report to Magister Anastia of Hardin .",
   "header": "Tablet of Vision",
   "outcome": "dead-end",
   "links": []
  },
