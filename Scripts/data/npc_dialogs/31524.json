  "Q00021_HiddenTruth/31524-02.html": {
   "file": "Q00021_HiddenTruth/31524-02.html",
   "quest": 21,
   "text": "Ghost of von Hellmann: I'm Duke Adolf von Hellmann, father of Alfred von Hellmann, who King Astor struck down with his spear. Why can't I rest in peace?! Who dares interrupt my sleep?",
   "header": "Ghost of von Hellmann",
   "links": [
    {
     "text": "\"Tell me more.\"",
     "bypass": "Quest Q00021_HiddenTruth 31524-03.html",
     "kind": "quest-event",
     "script": "Q00021_HiddenTruth",
     "event": "31524-03.html",
     "quest": 21,
     "to": "Q00021_HiddenTruth/31524-03.html"
    }
   ]
  },
  "Q00021_HiddenTruth/31524-03.html": {
   "file": "Q00021_HiddenTruth/31524-03.html",
   "quest": 21,
   "text": "Ghost of von Hellmann: Woe is me! This was once our home, but now we have no authority! Does this land still belong to the Elmore Kingdom?",
   "header": "Ghost of von Hellmann",
   "links": [
    {
     "text": "\"Elmore still rules here.\"",
     "bypass": "Quest Q00021_HiddenTruth 31524-04.html",
     "kind": "quest-event",
     "script": "Q00021_HiddenTruth",
     "event": "31524-04.html",
     "quest": 21,
     "to": "Q00021_HiddenTruth/31524-04.html"
    }
   ]
  },
  "Q00021_HiddenTruth/31524-04.html": {
   "file": "Q00021_HiddenTruth/31524-04.html",
   "quest": 21,
   "text": "Ghost of von Hellmann: Elmore? Why can't I feel the King's grace? What's happened here?",
   "header": "Ghost of von Hellmann",
   "links": [
    {
     "text": "\"I don't know.\"",
     "bypass": "Quest Q00021_HiddenTruth 31524-05.html",
     "kind": "quest-event",
     "script": "Q00021_HiddenTruth",
     "event": "31524-05.html",
     "quest": 21,
     "to": "Q00021_HiddenTruth/31524-05.html"
    }
   ]
  },
  "Q00021_HiddenTruth/31524-05.html": {
   "file": "Q00021_HiddenTruth/31524-05.html",
   "quest": 21,
   "text": "Ghost of von Hellmann: Find out what happened here and who has owned this land while I was sleeping! What's become of my family?",
   "header": "Ghost of von Hellmann",
   "links": [
    {
     "text": "\"I'll find out.\"",
     "bypass": "Quest Q00021_HiddenTruth 31524-06.html",
     "kind": "quest-event",
     "script": "Q00021_HiddenTruth",
     "event": "31524-06.html",
