  "Q00023_LidiasHeart/31524-03.html": {
   "file": "Q00023_LidiasHeart/31524-03.html",
   "quest": 23,
   "text": "Ghost of von Hellmann: How did she become the Lord of the Dead?",
   "header": "Ghost of von Hellmann",
   "links": [
    {
     "text": "\"Here's her diary.\"",
     "bypass": "Quest Q00023_LidiasHeart 31524-04.html",
