  "Q00023_LidiasHeart/31524-02.html": {
   "file": "Q00023_LidiasHeart/31524-02.html",
   "quest": 23,
   "text": "Ghost of von Hellmann: Oh, the horror! The von Hellmann's are dead and Lidia is a demon? Her curse upon this land is depriving me of my rest!",
   "header": "Ghost of von Hellmann",
   "links": [
    {
     "text": "\"It's the truth.\"",
     "bypass": "Quest Q00023_LidiasHeart 31524-03.html",
     "kind": "quest-event",
     "script": "Q00023_LidiasHeart",
     "event": "31524-03.html",
