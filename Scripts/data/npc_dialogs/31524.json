  "Q00021_HiddenTruth/31524-01.html": {
   "file": "Q00021_HiddenTruth/31524-01.html",
   "quest": 21,
   "text": "Ghost of von Hellmann: Who is calling me? Why am I stuck here? Why can't I sleep?",
   "header": "Ghost of von Hellmann",
   "when": [
    "cond 2"
   ],
   "links": [
    {
     "text": "\"Who are you? What's wrong?\"",
     "bypass": "Quest Q00021_HiddenTruth 31524-02.html",
