   ]
  },
  "Q00021_HiddenTruth/31524-07b.html": {
   "file": "Q00021_HiddenTruth/31524-07b.html",
   "quest": 21,
   "text": "Ghost of von Hellmann: I've repeatedly sent my servants to help you! Find the bookshelf that contains the history of the forest. It's somewhere in the south.",
   "header": "Ghost of von Hellmann",
   "when": [
    "cond 3; PAGE_SPAWNED"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00021_HiddenTruth/31524-07.html": {
   "file": "Q00021_HiddenTruth/31524-07.html",
   "quest": 21,
   "text": "Ghost of von Hellmann: Thank you! Please find out what's happened in the forest. Follow my servant and bring me the news!",
   "header": "Ghost of von Hellmann",
   "when": [
    "cond 3; !PAGE_SPAWNED; PAGE_COUNT < 5"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00021_HiddenTruth/31524-07a.html": {
   "file": "Q00021_HiddenTruth/31524-07a.html",
   "quest": 21,
   "text": "Ghost of von Hellmann: Find out what has happened in the forest! I'd have one of my servants show you the way, but they're all busy. Come back later!",
   "header": "Ghost of von Hellmann",
   "when": [
    "cond 3; !PAGE_SPAWNED; !PAGE_COUNT < 5"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00021_HiddenTruth/31524-07c.html": {
   "file": "Q00021_HiddenTruth/31524-07c.html",
   "quest": 21,
   "text": "Ghost of von Hellmann: You haven't found out enough to tell me why I can't rest in peace! Be gone!",
   "header": "Ghost of von Hellmann",
   "when": [
    "cond 4"
   ],
   "outcome": "dead-end",
   "links": []
  },
