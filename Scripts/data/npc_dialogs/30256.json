  "Q00419_GetAPet/30256-01.html": {
   "file": "Q00419_GetAPet/30256-01.html",
   "quest": 419,
   "text": "Gatekeeper Bella: Yes, it is true. I am a Gatekeeper from the Ivory Tower, and also a member of the animal lover's association. Why have you come? Did Martin send you?",
   "header": "Gatekeeper Bella",
   "when": [
    "state STARTED; has items 3417"
   ],
   "links": [
    {
     "text": "\"I wish to learn about pets.\"",
     "bypass": "Quest Q00419_GetAPet 30256-02.html",
     "kind": "quest-event",
     "script": "Q00419_GetAPet",
     "event": "30256-02.html",
