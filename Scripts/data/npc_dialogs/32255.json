  "Q00178_IconicTrinity/32255-11.html": {
   "file": "Q00178_IconicTrinity/32255-11.html",
   "quest": 178,
   "text": "Icon of the Past: ######################## %name1%: But...who in the world are you? ??? : Me? You will know soon, shortly after my story comes to an end. For now...call me N. Shall we begin? ######################## First, listen to the story.",
   "header": "Icon of the Past",
   "links": [
    {
     "text": "Watch the screen.",
     "bypass": "Quest Q00178_IconicTrinity 32255-12.html",
     "kind": "quest-event",
     "script": "Q00178_IconicTrinity",
