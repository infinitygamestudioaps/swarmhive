 "pages": {
  "ai/npc/KetraOrcSupport/31370-friend.html": {
   "file": "ai/npc/KetraOrcSupport/31370-friend.html",
   "quest": null,
   "text": "Hierarch Kadun Zu Ketra: We Ketras have come here to reclaim the land of our ancestors! We've discovered that the Varka Silenos, our loathsome enemy, defile this Holy Land! We will never forgive them this insult! Help us return to our homeland! May the flame of Pa'agrio burn within your heart etern…",
   "header": "Hierarch Kadun Zu Ketra",
   "when": [
    "(AllianceLevel > 0)"
   ],
   "links": [
    {
     "text": "Quest",
     "bypass": "npc_%objectId%_Quest",
     "kind": "quest-menu",
     "to": "@questlist"
    }
   ]
  },
  "ai/npc/KetraOrcSupport/31370-no.html": {
   "file": "ai/npc/KetraOrcSupport/31370-no.html",
   "quest": null,
   "text": "Hierarch Kadun Zu Ketra: Hold it, stranger! This is the sacred land of the Ketra! You defile it with your presence! We're different from the vile Orcs to the north... We'll surely reclaim this land of our ancestors! If you seriously want to help us return to our homeland, visit Messenger Wahkan!",
   "header": "Hierarch Kadun Zu Ketra",
   "when": [
    "NOT (AllianceLevel > 0)"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00606_BattleAgainstVarkaSilenos/31370-01.htm": {
   "file": "Q00606_BattleAgainstVarkaSilenos/31370-01.htm",
   "quest": 606,
   "text": "Kadun Zu Ketra: We must destroy the Varka Silenos, our ancient rivals! Who will join our cause?",
   "header": "Kadun Zu Ketra",
   "when": [
    "state CREATED; (player.getLevel() >= MIN_LEVEL)"
   ],
   "links": [
    {
     "text": "\"I'll fight the Varka Silenos.\"",
     "bypass": "Quest Q00606_BattleAgainstVarkaSilenos 31370-03.htm",
     "kind": "quest-event",
     "script": "Q00606_BattleAgainstVarkaSilenos",
     "event": "31370-03.htm",
     "quest": 606,
     "to": "Q00606_BattleAgainstVarkaSilenos/31370-03.htm",
     "effect": "start"
    }
   ]
  },
  "Q00606_BattleAgainstVarkaSilenos/31370-02.htm": {
   "file": "Q00606_BattleAgainstVarkaSilenos/31370-02.htm",
   "quest": 606,
   "text": "Kadun Zu Ketra: Your courage is admirable, but your abilities are lacking! Come back when you've developed your skills a bit more. (This quest may only be undertaken by a character of level 74 or above.)",
   "header": "Kadun Zu Ketra",
   "when": [
    "state CREATED; NOT (player.getLevel() >= MIN_LEVEL)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00606_BattleAgainstVarkaSilenos/31370-04.html": {
   "file": "Q00606_BattleAgainstVarkaSilenos/31370-04.html",
   "quest": 606,
   "text": "Kadun Zu Ketra: My colleague, have you slaughtered our enemies, the warriors of Varka Silenos? Did you hear their pitiful cries of defeat?",
   "header": "Kadun Zu Ketra",
   "when": [
    "state STARTED; (st.hasQuestItems(MANE))"
   ],
   "links": [
    {
     "text": "\"I will come back after killing more enemies.\"",
     "bypass": "Quest Q00606_BattleAgainstVarkaSilenos 31370-06.html",
     "kind": "quest-event",
     "script": "Q00606_BattleAgainstVarkaSilenos",
     "event": "31370-06.html",
     "quest": 606,
     "to": "Q00606_BattleAgainstVarkaSilenos/31370-06.html"
    },
    {
     "text": "\"I brought 100 manes for a start.\"",
     "bypass": "Quest Q00606_BattleAgainstVarkaSilenos 31370-07.html",
     "kind": "quest-event",
     "script": "Q00606_BattleAgainstVarkaSilenos",
     "event": "31370-07.html",
     "quest": 606,
     "to": "Q00606_BattleAgainstVarkaSilenos/31370-07.html",
     "toAll": [
      "Q00606_BattleAgainstVarkaSilenos/31370-07.html",
      "Q00606_BattleAgainstVarkaSilenos/31370-08.html"
     ]
    },
    {
     "text": "\"I want to quit.\"",
     "bypass": "Quest Q00606_BattleAgainstVarkaSilenos 31370-09.html",
     "kind": "quest-event",
     "script": "Q00606_BattleAgainstVarkaSilenos",
     "event": "31370-09.html",
     "quest": 606,
     "to": "Q00606_BattleAgainstVarkaSilenos/31370-09.html",
     "effect": "end"
    }
   ]
  },
  "Q00606_BattleAgainstVarkaSilenos/31370-05.html": {
   "file": "Q00606_BattleAgainstVarkaSilenos/31370-05.html",
   "quest": 606,
   "text": "Kadun Zu Ketra: Wipe out the enemy! Don't let any Varka Silenos survive! Kill them all!",
   "header": "Kadun Zu Ketra",
   "when": [
    "state STARTED; NOT (st.hasQuestItems(MANE))"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00607_ProveYourCourageKetra/31370-01.htm": {
   "file": "Q00607_ProveYourCourageKetra/31370-01.htm",
   "quest": 607,
   "text": "Kadun Zu Ketra: We've been at war with the murderous Varka Silenos for far too long! It's time that we put an end to this once and for all, and thrust our sword to the very core of the enemy forces! Comrade of Ketra! Will you join our struggle?",
   "header": "Kadun Zu Ketra",
   "when": [
    "state CREATED; (player.getLevel() >= MIN_LEVEL); (st.hasQuestItems(KETRA_ALLIANCE_THREE))"
   ],
   "links": [
    {
     "text": "\"I'll do it!\"",
     "bypass": "Quest Q00607_ProveYourCourageKetra 31370-04.htm",
     "kind": "quest-event",
     "script": "Q00607_ProveYourCourageKetra",
     "event": "31370-04.htm",
     "quest": 607,
     "to": "Q00607_ProveYourCourageKetra/31370-04.htm",
     "effect": "start"
    }
   ]
  },
  "Q00607_ProveYourCourageKetra/31370-02.htm": {
   "file": "Q00607_ProveYourCourageKetra/31370-02.htm",
   "quest": 607,
   "text": "Kadun Zu Ketra: I must find a worthy fighter to accomplish this mission. Unfortunately you don't seem up to the task. (Only a character who possesses Ketra's friend - 3rd level can undertake this quest.)",
   "header": "Kadun Zu Ketra",
   "when": [
    "state CREATED; (player.getLevel() >= MIN_LEVEL); NOT (st.hasQuestItems(KETRA_ALLIANCE_THREE))"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00607_ProveYourCourageKetra/31370-03.htm": {
   "file": "Q00607_ProveYourCourageKetra/31370-03.htm",
   "quest": 607,
   "text": "Kadun Zu Ketra: You're not ready for this type of mission. Practice! (Only a character of level 75 or above can undertake this quest.)",
