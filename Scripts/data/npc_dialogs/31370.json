  "Q00608_SlayTheEnemyCommanderKetra/31370-01.htm": {
   "file": "Q00608_SlayTheEnemyCommanderKetra/31370-01.htm",
   "quest": 608,
   "text": "Kadun Zu Ketra: The time has come for our revenge! Let's slay the commander of the enemy forces and put an end to our long war with the Varka! Will you join our cause?",
   "header": "Kadun Zu Ketra",
   "when": [
    "state CREATED; (player.getLevel() >= MIN_LEVEL); (st.hasQuestItems(KETRA_ALLIANCE_FOUR))"
   ],
   "links": [
    {
     "text": "\"I'll do it.\"",
