  "Q00608_SlayTheEnemyCommanderKetra/31370-06.html": {
   "file": "Q00608_SlayTheEnemyCommanderKetra/31370-06.html",
   "quest": 608,
   "text": "Kadun Zu Ketra: Arise, Orcs! The time has come! Kill Mos, the Varka commander, cut off his head and bring it to me!",
   "header": "Kadun Zu Ketra",
   "when": [
    "state STARTED; NOT (st.isCond(2) && st.hasQuestItems(MOS_HEAD))"
