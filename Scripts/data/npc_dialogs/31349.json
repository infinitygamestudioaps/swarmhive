  "default/31349.htm": {
   "file": "default/31349.htm",
   "quest": null,
   "text": "Benedict: What are you doing here? I haven't seen you around here before. Is this your first time here? If you're here to give a donation, talk to Agripel over there. Why are you staring at me? Is there something stuck in my teeth?",
   "header": "Benedict",
