  "Q00172_NewHorizons/32163-01.html": {
   "file": "Q00172_NewHorizons/32163-01.html",
   "quest": 172,
   "text": "Gatekeeper Ragara: Oh! So Zenya sent you here! Zenya has been encouraging young people to leave the boundaries of this island and explore the wide world beyond. As a result, we now have the opportunity to travel to Giran. Here, take this.",
   "header": "Gatekeeper Ragara",
   "when": [
