  "Q00172_NewHorizons/32163-02.html": {
   "file": "Q00172_NewHorizons/32163-02.html",
   "quest": 172,
   "text": "Gatekeeper Ragara: It is a scroll called the \"Scroll of Escape: Town of Giran\". Use it to safely transport yourself to Town of Giran. But use it wisely -- it will disappear after just one use! Ah! Here is a Mark of Traveler that Zenya prepared for you. When you decide to return to the Isle of Souls…",
   "header": "Gatekeeper Ragara",
   "sets": {
    "reward": true
   },
   "outcome": "reward",
   "links": []
  },
