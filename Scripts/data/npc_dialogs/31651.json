   "quest": 98,
   "text": "Tablet of Vision: The tablet begins to tremor. Someone is nearby!",
   "header": "Tablet of Vision",
   "when": [
    "cond 8; !((npcId == 31581) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
