  "Q00098_SagaOfTheShillienSaint/7-05.htm": {
   "file": "Q00098_SagaOfTheShillienSaint/7-05.htm",
   "quest": 98,
   "text": "Tablet of Vision: The tablet begins to buzz as the Stone of Commune draws nearer.",
   "header": "Tablet of Vision",
   "when": [
    "cond 9; !((npcId == 31581) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
