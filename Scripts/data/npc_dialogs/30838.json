  "Q00033_MakeAPairOfDressShoes/30838-04.html": {
   "file": "Q00033_MakeAPairOfDressShoes/30838-04.html",
   "quest": 33,
   "text": "Trader Woodley: Welcome. If you get some of the same material from your order with Leikar, I can make you shoes to match.",
   "header": "Trader Woodley",
   "when": [
    "state STARTED; cond 1"
