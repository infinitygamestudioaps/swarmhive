  "merchant/30838-pk.htm": {
   "file": "merchant/30838-pk.htm",
   "quest": null,
   "text": "Trader Woodley: I'm done talking with you. Get out of my store. Outward appearances mean little to me, its what is on the inside that is important. You come up short in that department. Leave!",
   "header": "Trader Woodley",
   "outcome": "dead-end",
   "links": []
