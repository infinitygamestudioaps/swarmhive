  "Q00033_MakeAPairOfDressShoes/30838-05.html": {
   "file": "Q00033_MakeAPairOfDressShoes/30838-05.html",
   "quest": 33,
   "text": "Trader Woodley: Leikar's short on fabric? It's hard to make something using the color but not the fabric. Can you help?",
   "header": "Trader Woodley",
   "when": [
    "state STARTED; cond 2"
   ],
   "links": [
    {
     "text": "\"I'll try.\"",
