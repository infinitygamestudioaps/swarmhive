  },
  "Q00120_PavelsLastResearch/32046-28.html": {
   "file": "Q00120_PavelsLastResearch/32046-28.html",
   "quest": 120,
   "text": "Atlanta: You must check out the Weathermaster device in the north wing. The password is \"ATL\" . If any project is activated, please put a stop to it at once!",
   "header": "Atlanta",
   "when": [
    "state STARTED; memo 8"
   ],
   "links": [
    {
     "text": "\"How do I know if a project is activated?\"",
     "bypass": "Quest Q00120_PavelsLastResearch 32046-26.html",
     "kind": "quest-event",
     "script": "Q00120_PavelsLastResearch",
     "event": "32046-26.html",
     "quest": 120,
     "to": "Q00120_PavelsLastResearch/32046-26.html"
    },
    {
     "text": "\"What are the Weathermaster's defenses?\"",
     "bypass": "Quest Q00120_PavelsLastResearch 32046-27.html",
