  "Q00120_PavelsLastResearch/32046-12.html": {
   "file": "Q00120_PavelsLastResearch/32046-12.html",
   "quest": 120,
   "text": "Atlanta: Please, find my child! I can feel her presence nearby! I've lost most of my memory, but I know that I simply must find that child! Please, ask around about her.",
   "header": "Atlanta",
   "when": [
    "state STARTED; memo 2"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00120_PavelsLastResearch/32046-13.html": {
   "file": "Q00120_PavelsLastResearch/32046-13.html",
   "quest": 120,
   "text": "Atlanta: Did you find my child?",
   "header": "Atlanta",
   "when": [
    "state STARTED; memo 3"
   ],
   "links": [
    {
     "text": "\"Wendy lost her memory, too.\"",
     "bypass": "Quest Q00120_PavelsLastResearch 32046-14.html",
     "kind": "quest-event",
     "script": "Q00120_PavelsLastResearch",
     "event": "32046-14.html",
