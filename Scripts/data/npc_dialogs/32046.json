    }
   ]
  },
  "Q00120_PavelsLastResearch/32046-16.html": {
   "file": "Q00120_PavelsLastResearch/32046-16.html",
   "quest": 120,
   "text": "Atlanta: Take this flower to Wendy. Hopefully, she'll remember it as mine from long ago... If this doesn't restore her memory, nothing will!",
   "header": "Atlanta",
   "when": [
    "state STARTED; memo 4; has items 8290"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00120_PavelsLastResearch/32046-17.html": {
   "file": "Q00120_PavelsLastResearch/32046-17.html",
   "quest": 120,
   "text": "Atlanta: Did you give Wendy the flower? What did she say?",
   "header": "Atlanta",
   "when": [
    "state STARTED; memo 7"
   ],
   "links": [
    {
     "text": "\"Tell me about Pavel's last study.\"",
     "bypass": "Quest Q00120_PavelsLastResearch 32046-18.html",
     "kind": "quest-event",
     "script": "Q00120_PavelsLastResearch",
     "event": "32046-18.html",
