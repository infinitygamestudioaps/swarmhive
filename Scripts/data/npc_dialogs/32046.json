  "Q00114_ResurrectionOfAnOldManager/32046-06.html": {
   "file": "Q00114_ResurrectionOfAnOldManager/32046-06.html",
   "quest": 114,
   "text": "Atlanta: .... Who... who...is...waking......me....",
   "header": "Atlanta",
