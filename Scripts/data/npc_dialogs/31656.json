  "Q00100_SagaOfTheMaestro/10-05.htm": {
   "file": "Q00100_SagaOfTheMaestro/10-05.htm",
   "quest": 100,
   "text": "Tablet of Vision: The tablet is inscribed with indecipherable hieroglyphs. The letters emit a dim light and the tablet seems to manifest strong magical powers.",
   "header": "Tablet of Vision",
   "when": [
    "cond 18; !((npcId == 31592) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "links": [
    {
     "text": "Use the Stone of Commune.",
     "bypass": "Quest Q00100_SagaOfTheMaestro 10-2",
