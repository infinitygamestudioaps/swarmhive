  "Q00095_SagaOfTheHellKnight/10-07.htm": {
   "file": "Q00095_SagaOfTheHellKnight/10-07.htm",
   "quest": 95,
   "text": "Tablet of Vision: Further communion with this tablet would be futile. You've heard what Waldstein had to say, so go back to Dark Knight Mordred .",
   "header": "Tablet of Vision",
   "when": [
    "cond 19; !((npcId == 31582) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00096_SagaOfTheSpectralDancer/10-01.htm": {
   "file": "Q00096_SagaOfTheSpectralDancer/10-01.htm",
   "quest": 96,
   "text": "Tablet of Vision: The tablet is softly vibrating. Someone with the Stone of Commune must be nearby.",
   "header": "Tablet of Vision",
   "when": [
    "cond 17; !((npcId == 31582) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "links": [
    {
     "text": "Patrol the area.",
