  "Q00096_SagaOfTheSpectralDancer/10-07.htm": {
   "file": "Q00096_SagaOfTheSpectralDancer/10-07.htm",
   "quest": 96,
   "text": "Tablet of Vision: The tablet goes still and dark as if nothing had happened. Everything's over. Go back to Dark Knight Mordred at Hardin's Academy.",
   "header": "Tablet of Vision",
   "when": [
    "cond 19; !((npcId == 31582) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00100_SagaOfTheMaestro/10-01.htm": {
   "file": "Q00100_SagaOfTheMaestro/10-01.htm",
   "quest": 100,
   "text": "Tablet of Vision: You can feel the presence of the Stone of Commune near the tablet. You feel you can find out its exact location if you lay your hands on the tablet.",
   "header": "Tablet of Vision",
   "when": [
    "cond 17; !((npcId == 31592) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "links": [
    {
     "text": "Lay hands on the tablet.",
     "bypass": "Quest Q00100_SagaOfTheMaestro 10-1",
