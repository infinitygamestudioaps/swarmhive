     ],
     "effect": "cond:17"
    }
   ]
  },
  "Q00096_SagaOfTheSpectralDancer/10-05.htm": {
   "file": "Q00096_SagaOfTheSpectralDancer/10-05.htm",
   "quest": 96,
   "text": "Tablet of Vision: The tablet responds as you approach with the Stone of Commune.",
   "header": "Tablet of Vision",
   "when": [
    "cond 18; !((npcId == 31582) && st.isCompleted()); player.getClassId().getId() == getPrevClass(player)"
   ],
   "links": [
