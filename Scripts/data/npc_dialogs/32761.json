   "links": []
  },
  "Q10287_StoryOfThoseLeft/32761-05.html": {
   "file": "Q10287_StoryOfThoseLeft/32761-05.html",
   "quest": 10287,
   "text": "Kegor: Before you leave, talk to Jinia. We will prepare for what's next.",
   "header": "Kegor",
   "when": [
    "state STARTED; memo 1; !((memoStateEx1 == 1) && (memoStateEx2 == 0)); !((memoStateEx1 == 0) && (memoStateEx2 == 0)); memoStateEx1 == 1; memoStateEx2 == 1"
   ],
