  "merchant/31302-pk.htm": {
   "file": "merchant/31302-pk.htm",
   "quest": null,
   "text": "Trader Vladimir: Have you heard of the vampire Vladimir? How about Bloody Vlad? They are the elders of my family! Are you starting to understand? Now get going! Unwanted guests don't last long around here!",
   "header": "Trader Vladimir",
   "outcome": "dead-end",
   "links": []
  },
