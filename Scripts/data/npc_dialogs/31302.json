 "pages": {
  "merchant/31302.htm": {
   "file": "merchant/31302.htm",
   "quest": null,
   "text": "Trader Vladimir: Oh, my! A customer! Come this way! A dignified adventurer like you shouldn't have to deal with a huckster like Drumond. Times are chaotic, and you must prepare yourself accordingly. The equipment we sell is only of the best quality and purest materials. Would I lie to you?",
   "header": "Trader Vladimir",
   "links": [
    {
     "text": "Buy/Sell/Refund.",
     "bypass": "npc_%objectId%_Chat 1",
     "kind": "page",
     "to": "merchant/31302-1.htm"
    },
    {
     "text": "Try on Fighter equipment.",
     "bypass": "npc_%objectId%_Wear 3130200",
     "kind": "shop"
    },
    {
     "text": "Try on Wizard equipment.",
     "bypass": "npc_%objectId%_Wear 3130201",
     "kind": "shop"
    },
    {
