   "quest": 22,
   "text": "Ghost of Priest: It's all so foggy. Can you be more specific?",
   "header": "Ghost of Priest",
   "links": [
    {
     "text": "\"What about the Lord of Forest of the Dead?\"",
     "bypass": "Quest Q00022_TragedyInVonHellmannForest 31528-05.html",
     "kind": "quest-event",
     "script": "Q00022_TragedyInVonHellmannForest",
     "event": "31528-05.html",
     "quest": 22,
