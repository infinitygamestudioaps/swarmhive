 "pages": {
  "default/31532.htm": {
   "file": "default/31532.htm",
   "quest": null,
   "text": "Maid of Lidia: Isn't it a beutiful night...? It's so pleasant out here! And the moon shines so brightly...",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "Quest",
     "bypass": "npc_%objectId%_Quest",
     "kind": "quest-menu",
     "to": "@questlist"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-01.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-01.html",
   "quest": 24,
   "text": "Maid of Lidia: My lady thanks you for recovering the Silver Spear. It's a family treasure.",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; cond 5"
   ],
   "links": [
    {
     "text": "\"I was doing my duty.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-02.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-02.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-02.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-05.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-05.html",
   "quest": 24,
   "text": "Maid of Lidia: I don't know what it says, I wouldn't dream of reading the letter meant for my lord! I was told you had something for me?",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; cond 6"
   ],
   "links": [
    {
     "text": "\"Here's the hairpin.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-07.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-07.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-07.html",
     "toAll": [
      "Q00024_InhabitantsOfTheForestOfTheDead/31532-07.html",
      "Q00024_InhabitantsOfTheForestOfTheDead/31532-06.html"
     ],
     "effect": "cond:7"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-07a.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-07a.html",
   "quest": 24,
   "text": "Maid of Lidia: Do you have something for me?",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; cond 7",
    "state STARTED; cond 8; switch(st.getInt(\"var\")) case 0"
   ],
   "links": [
    {
     "text": "\"Here's the hairpin.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-07.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-07.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-07.html",
     "toAll": [
      "Q00024_InhabitantsOfTheForestOfTheDead/31532-07.html",
      "Q00024_InhabitantsOfTheForestOfTheDead/31532-06.html"
     ],
     "effect": "cond:7"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-08.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-08.html",
   "quest": 24,
   "text": "Maid of Lidia: What is it?",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; cond 8; switch(st.getInt(\"var\")) case 1"
   ],
   "links": [
    {
     "text": "\"What do you know about Neidrahu?\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-10.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-10.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-10.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-11.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-11.html",
   "quest": 24,
   "text": "Maid of Lidia: Did I say Neidrahu? What do you know of the name?",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; cond 8; switch(st.getInt(\"var\")) case 2"
   ],
   "links": [
    {
     "text": "\"It's a tree.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-12.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-12.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-12.html"
    },
    {
     "text": "\"It's a corpse.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-13.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-13.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-13.html"
    },
    {
     "text": "\"It's a Mystic.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-14.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-14.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-14.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-15.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-15.html",
   "quest": 24,
   "text": "Maid of Lidia: Oh! Only Lord Alfred and Lady Lidia know. Even Einhalder thinks he's an ordinary Mystic! How do you know of this?",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; cond 8; switch(st.getInt(\"var\")) case 3"
   ],
   "links": [
    {
     "text": "\"I read the diary.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-16.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-16.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-16.html"
    },
    {
     "text": "\"How do you know?\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-17.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-17.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-17.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-20.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-20.html",
   "quest": 24,
   "text": "Maid of Lidia: This I can tell you. The black magi roam freely during the day, but are fewer at night. Some carry odd looking dolls. Take one to their master, I'm sure he can tell you more!",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; cond 9|10"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00025_HidingBehindTheTruth/31532-01.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-01.html",
   "quest": 25,
   "text": "Maid of Lidia: May I read that piece of paper?",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; memo 9; has items 7066"
   ],
   "links": [
    {
     "text": "\"Of course.\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-02.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-02.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-02.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-03.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-03.html",
   "quest": 25,
   "text": "Maid of Lidia: This contract was made between the Devil Triol, Black Mystic Hardin and the Lord of the Forest of the Dead. Hardin! If you spell his name backwards...Of course!",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; memo 10"
   ],
   "links": [
    {
     "text": "\"Are you OK?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-05.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-05.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-05.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-08.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-08.html",
   "quest": 25,
   "text": "Maid of Lidia: When the contract was signed...Lidia...the red dress... I must find the dress Rose wore!",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; memo 11"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00025_HidingBehindTheTruth/31532-09.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-09.html",
   "quest": 25,
   "text": "Maid of Lidia: This is it! The dress Rose was wearing! Now I remember... I'll tell you what I know, but... ...please...leave me alone for a minute.",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; memo 12; has items 7155"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00025_HidingBehindTheTruth/31532-10.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-10.html",
   "quest": 25,
   "text": "Maid of Lidia: I'll tell you, but please...leave me alone for a minute.",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; memo 13"
   ],
   "links": [
    {
     "text": "\"I'll wait.\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-11.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-11.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-11.html",
     "toAll": [
      "Q00025_HidingBehindTheTruth/31532-11.html",
      "Q00025_HidingBehindTheTruth/31532-12.html"
     ]
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-13.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-13.html",
   "quest": 25,
   "text": "Maid of Lidia: Now I'll answer your questions as best I can. I'm grateful to have met you.",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; memo 14"
   ],
   "links": [
    {
     "text": "\"What about the dress?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-14.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-14.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-14.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-18.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-18.html",
   "quest": 25,
   "text": "Maid of Lidia: Hardin, Triol and Lidia all had secret contracts before signing this one. I can only tell you about Lidia's.",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; memo 15"
   ],
   "links": [
    {
     "text": "\"What was it?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-19.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-19.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-19.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-22.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-22.html",
   "quest": 25,
   "text": "Maid of Lidia: I am Lidia von Hellmann! I must have written the diary and the letter I gave you. My memory is incomplete and is being controlled by Hardin. I don't understand why Hardin would help me regain my memory now. Perhaps you should ask him about it.",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; memo 16"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00025_HidingBehindTheTruth/31532-23.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-23.html",
   "quest": 25,
   "text": "Maid of Lidia: I was hoping we would meet again. I forgot to tell you something very important. My body may be gone, but now I can live my own life and follow my own fate thanks to you. Hardin controlled the missing piece of my memory, but now it's complete. He no longer has any influence over me! …",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; memo 23"
   ],
   "links": [
    {
     "text": "\"You're welcome. I wish you the best!\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-25.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-25.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-25.html",
     "effect": "reward"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-24.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-24.html",
   "quest": 25,
   "text": "Maid of Lidia: A black magus is looking for you in the Forest of the Dead. I told him everything that's happened to me. Please meet with him.",
   "header": "Maid of Lidia",
   "when": [
    "state STARTED; memo 24"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-02.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-02.html",
   "quest": 24,
   "text": "Maid of Lidia: She knows how you helped her ancestors rest in peace. My lady knows all that happens in her forest!",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"Everything?\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-03.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-03.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-03.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-03.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-03.html",
   "quest": 24,
   "text": "Maid of Lidia: My lady knows everything about your journeys here. She hopes you'll uncover all the details of what has transpired.",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"Please continue.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-04.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-04.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-04.html",
     "effect": "cond:6"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-04.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-04.html",
   "quest": 24,
   "text": "Maid of Lidia: Come back after reading this letter from my lady.",
   "header": "Maid of Lidia",
   "sets": {
    "cond": "6"
   },
   "outcome": "cond",
   "links": []
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-06.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-06.html",
   "quest": 24,
   "text": "Maid of Lidia: This is Neidrahu's work, a hairpin of Moon Face Flower. How beautiful! I must go now.",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"Wait!\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-09.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-09.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-09.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-07.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-07.html",
   "quest": 24,
   "text": "Maid of Lidia: Oh no! Could you have dropped it in the village? Take the letter with you and ask around for it. Meet me again tomorrow night.",
   "header": "Maid of Lidia",
   "sets": {
    "cond": "7"
   },
   "outcome": "cond",
   "links": []
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-09.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-09.html",
   "quest": 24,
   "text": "Maid of Lidia: What is it?",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"Tell me everything you know about Neidrahu!\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-10.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-10.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-10.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-10.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-10.html",
   "quest": 24,
   "text": "Maid of Lidia: Did I say Neidrahu? What do you know of the name?",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"It's a tree.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-12.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-12.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-12.html"
    },
    {
     "text": "\"It's a corpse.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-13.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-13.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-13.html"
    },
    {
     "text": "\"It's a Mystic.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-14.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-14.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-14.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-12.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-12.html",
   "quest": 24,
   "text": "Maid of Lidia: Perhaps there is a tree with that name. Why would you think I had anything to do with this?",
   "header": "Maid of Lidia",
   "outcome": "dead-end",
   "links": []
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-13.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-13.html",
   "quest": 24,
   "text": "Maid of Lidia: This manor is covered in corpses. This is the Forest of the Dead. Why do you keep asking about it?",
   "header": "Maid of Lidia",
   "outcome": "dead-end",
   "links": []
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-14.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-14.html",
   "quest": 24,
   "text": "Maid of Lidia: What kind of Mystic was he?",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"A Mystic of Dark Arts!\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-15.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-15.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-15.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-16.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-16.html",
   "quest": 24,
   "text": "Maid of Lidia: Did you read of the contract between Neidrahu and my lady in the diary?",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"Now you must tell me what you know!\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-18.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-18.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-18.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-17.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-17.html",
   "quest": 24,
   "text": "Maid of Lidia: How do you know about Neidrahu? Are you the last survivor? If so, you'll never get out of this forest alive...or dead!",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"I read the diary.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-16.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-16.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-16.html"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-18.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-18.html",
   "quest": 24,
   "text": "Maid of Lidia: I was there when the contract was signed, but the memory of the undead is not very clear. If you find out what's on the missing page, when the contract was signed, I'll tell you more.",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"I've already come this far.\"",
     "bypass": "Quest Q00024_InhabitantsOfTheForestOfTheDead 31532-19.html",
     "kind": "quest-event",
     "script": "Q00024_InhabitantsOfTheForestOfTheDead",
     "event": "31532-19.html",
     "quest": 24,
     "to": "Q00024_InhabitantsOfTheForestOfTheDead/31532-19.html",
     "effect": "cond:9"
    }
   ]
  },
  "Q00024_InhabitantsOfTheForestOfTheDead/31532-19.html": {
   "file": "Q00024_InhabitantsOfTheForestOfTheDead/31532-19.html",
   "quest": 24,
   "text": "Maid of Lidia: This I can tell you. The black magi roam freely during the day, but are fewer at night. Some carry odd looking dolls. Take one to their master, I'm sure he can tell you more!",
   "header": "Maid of Lidia",
   "sets": {
    "cond": "9"
   },
   "outcome": "cond",
   "links": []
  },
  "Q00025_HidingBehindTheTruth/31532-02.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-02.html",
   "quest": 25,
   "text": "Maid of Lidia: This is the contract!",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"What does it say?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-04.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-04.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-04.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-04.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-04.html",
   "quest": 25,
   "text": "Maid of Lidia: This contract was made between the Devil Triol, Black Mystic Hardin and the Lord of the Forest of the Dead. Hardin! If you spell his name backwards...Of course!",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "You look so pale! Are you okay?",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-05.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-05.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-05.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-05.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-05.html",
   "quest": 25,
   "text": "Maid of Lidia: Now I can remember... Why was I using the large room ? ...The sound of fighting...I ran away... I was wearing the hairpin . ...Rose was wearing the red dress!!",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"Are you OK?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-06.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-06.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-06.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-06.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-06.html",
   "quest": 25,
   "text": "Maid of Lidia: DRESS...THE DRESS!.MY RED DRESS!.IT'S DISAPPEARED.WHAT'S GOING ON?.WHERE IS ROSE?.WHY AM I HERE?.DADDY I'M SCARED!...ROSE.ROSE PUT ON MY DRESS AND LEFT!.MY RED DRESS...PEOPLE ARE COMING!.NO!.DADDY YOU SHOULDN'T GO OUTSIDE!.WHERE'S NIDRAH?.SAVE MY FATHER!.YOU'RE A MYSTIC!.YOU CAN DO A…",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"WAKE UP...! SNAP OUT OF IT!!\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-07.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-07.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-07.html",
     "effect": "cond:11"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-07.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-07.html",
   "quest": 25,
   "text": "Maid of Lidia: When the contract was signed...Lidia...the red dress... I need to find the dress Rose wore!",
   "header": "Maid of Lidia",
   "sets": {
    "cond": "11"
   },
   "outcome": "cond",
   "links": []
  },
  "Q00025_HidingBehindTheTruth/31532-11.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-11.html",
   "quest": 25,
   "text": "Maid of Lidia: ...",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"Wait!\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-11.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-11.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-11.html",
     "toAll": [
      "Q00025_HidingBehindTheTruth/31532-11.html",
      "Q00025_HidingBehindTheTruth/31532-12.html"
     ]
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-12.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-12.html",
   "quest": 25,
   "text": "Maid of Lidia: Now I'll answer your questions as best I can. I'm grateful to have met you.",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"What about the dress?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-14.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-14.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-14.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-14.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-14.html",
   "quest": 25,
   "text": "Maid of Lidia: This dress is... It was Lidia's most treasured dress. She wore this red dress on special occasions with the Moon Face Flower hairpin. And on the day of the tragedy of Hellmann Forest... Rose, the maid of Lidia, wore it to divert attention from Lidia.",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"Why is Rose's grave empty?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-15.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-15.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-15.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-15.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-15.html",
   "quest": 25,
   "text": "Maid of Lidia: The dress deceived the attackers. Rose sacrificed herself for Lidia.",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"Why the fake grave?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-16.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-16.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-16.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-16.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-16.html",
   "quest": 25,
   "text": "Maid of Lidia: Lidia believes Rose is buried there. She signed the contract and became Lord of the Forest of the Dead because of Rose's sacrifice.",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"Tell me more about the contract.\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-17.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-17.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-17.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-17.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-17.html",
   "quest": 25,
   "text": "Maid of Lidia: Hardin, Triol and Lidia all had secret contracts before signing this one. I can only tell you about Lidia's.",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"What was it?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-19.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-19.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-19.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-19.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-19.html",
   "quest": 25,
   "text": "Maid of Lidia: Lidia signed a contract with Nidrah, that is, Hardin, to summon the devil Triol. She gave her life to Hardin, who then played a trick on her.",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"What trick?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-20.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-20.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-20.html"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-20.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-20.html",
   "quest": 25,
   "text": "Maid of Lidia: He took her memory and put it in another body. He gave only her knowledge and grievances to Triol, who used them to create the Lord of the Forest of Dead, Lidia von Hellmann. And the memory of Lidia was put in the corpse of the maid Rose who was the best friend of Lidia's. Rose was t…",
   "header": "Maid of Lidia",
   "links": [
    {
     "text": "\"So who are you?\"",
     "bypass": "Quest Q00025_HidingBehindTheTruth 31532-21.html",
     "kind": "quest-event",
     "script": "Q00025_HidingBehindTheTruth",
     "event": "31532-21.html",
     "quest": 25,
     "to": "Q00025_HidingBehindTheTruth/31532-21.html",
     "effect": "cond:15"
    }
   ]
  },
  "Q00025_HidingBehindTheTruth/31532-21.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-21.html",
   "quest": 25,
   "text": "Maid of Lidia: I am Lidia von Hellmann! I must have written the diary and the letter I gave you. My memory is incomplete and is being controlled by Hardin. I don't understand why Hardin would help me regain my memory now. Perhaps you should ask him about it.",
   "header": "Maid of Lidia",
   "sets": {
    "cond": "15"
   },
   "outcome": "cond",
   "links": []
  },
  "Q00025_HidingBehindTheTruth/31532-25.html": {
   "file": "Q00025_HidingBehindTheTruth/31532-25.html",
   "quest": 25,
   "text": "Maid of Lidia: When I was younger I used to dream of a hero who would rescue me. I don't have anything valuable to reward you with, but please take this as a token of my undying gratitude.",
   "header": "Maid of Lidia",
   "sets": {
    "reward": true
   },
   "outcome": "reward",
   "links": []
  },
