  "teleporter/30006.htm": {
   "file": "teleporter/30006.htm",
   "quest": null,
   "text": "Gatekeeper Roxxy: Welcome! I am Gatekeeper Roxxy, dispatched from the Ivory Tower. I'm very happy to return to my hometown. Perhaps you have been to the Einhovant's School of Magic? Grand Magister Gallint was my old teacher. Well then, what can I do for you?",
   "header": "Gatekeeper Roxxy",
   "links": [
    {
     "text": "Ask about the airship wharf.",
     "bypass": "npc_%objectId%_Chat 5",
     "kind": "page",
     "to": "teleporter/30006-5.htm",
     "live": true,
     "dpText": "Ask about the Airship Wharf."
    },
    {
     "text": "Ask about the Ivory Tower.",
     "bypass": "npc_%objectId%_Chat 4",
     "kind": "page",
     "to": "teleporter/30006-4.htm",
