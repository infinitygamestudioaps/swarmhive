  "Q00247_PossessorOfAPreciousSoul4/31740-1.htm": {
   "file": "Q00247_PossessorOfAPreciousSoul4/31740-1.htm",
   "quest": 247,
   "text": "Caradine: Thank you for coming. I asked you here because the time has come for you to meet her. Isn't that what you wanted? Prepare to have all your questions answered and your horizons broadened! Are you ready to change your life?",
   "header": "Caradine",
   "when": [
