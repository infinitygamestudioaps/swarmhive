  "Q00246_PossessorOfAPreciousSoul3/31740-1.htm": {
   "file": "Q00246_PossessorOfAPreciousSoul3/31740-1.htm",
   "quest": 246,
   "text": "Caradine: Welcome back! I heard what happened. Thank you on behalf of the group! I never imagined that there would be such resistance to our work! We're probably safe now, but the Lady of the Lake hasn't completely recovered yet. She still needs some more rest. Could you please help us some more?",
   "header": "Caradine",
   "when": [
    "state CREATED; ((player.getLevel() >= 65) && player.hasQuestCompleted(Q00242_PossessorOfAPreciousSoul2.class.getSim"
   ],
   "links": [
    {
