  "default/31740.htm": {
   "file": "default/31740.htm",
   "quest": null,
   "text": "Caradine: My name is Caradine. I am the first daughter of the Naird family that has served the Lady of the Lake for generations. The year I turned 20 I followed my mother Morigan in service to the lady. To fulfill my lady's will I've traveled all over the world. No! You're wrong! She's real! Once w…",
   "header": "Caradine",
   "links": [
