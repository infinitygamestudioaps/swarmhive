  "Q00241_PossessorOfAPreciousSoul1/31740-01.html": {
   "file": "Q00241_PossessorOfAPreciousSoul1/31740-01.html",
   "quest": 241,
   "text": "Caradine: The star of fate must have brought you here. It is an honor indeed to meet someone who carries such a precious soul. You are surely the one sent by Her to complete our remaining work. The Lady of the Lake... She is the one who continues to hope for the criminals of the world, even if that…",
   "header": "Caradine",
   "when": [
    "cond >=18"
   ],
   "links": [
    {
     "text": "\"I will.\"",
     "bypass": "Quest Q00241_PossessorOfAPreciousSoul1 31740-04.html",
     "kind": "quest-event",
     "script": "Q00241_PossessorOfAPreciousSoul1",
     "event": "31740-04.html",
     "quest": 241,
     "to": "Q00241_PossessorOfAPreciousSoul1/31740-04.html"
