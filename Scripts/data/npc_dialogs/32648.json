     "kind": "page",
     "to": "teleporter/32648-1.htm"
    },
    {
     "text": "Move to one of the places mentioned in an update.",
     "bypass": "npc_%objectId%_Chat 2",
     "kind": "page",
     "to": "teleporter/32648-2.htm"
    },
    {
     "text": "Move to a city.",
