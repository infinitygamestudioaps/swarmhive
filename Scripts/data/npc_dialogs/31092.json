  "Q00060_GoodWorksReward/31092-04a.html": {
   "file": "Q00060_GoodWorksReward/31092-04a.html",
   "quest": 60,
   "text": "Black Marketeer of Mammon: Here it is, my friend. Thank you for your help. If you must one day take another test, come and see me. I will be able to help you.",
   "header": "Black Marketeer of Mammon",
   "outcome": "dead-end",
   "links": []
