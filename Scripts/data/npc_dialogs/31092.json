  "ai/npc/BlackMarketeerOfMammon/31092-01.html": {
   "file": "ai/npc/BlackMarketeerOfMammon/31092-01.html",
   "quest": null,
   "text": "Black Marketeer of Mammon: The cost is high if you wish to keep the ancient Adena from corroding. I'm sure you won't like it, but you must pay 4 times the normal cost. Also, we only see in bundles of 500,000 ancient Adena. To make sure the ancient currency is spread widely, we have limited the amou…",
   "header": "Black Marketeer of Mammon",
   "when": [
    "exchangeAvailable()"
   ],
   "links": [
    {
     "text": "Exchange 2,000,000 Adena for 500,000 ancient Adena",
     "bypass": "Quest BlackMarketeerOfMammon exchange",
     "kind": "quest-event",
     "script": "BlackMarketeerOfMammon",
     "event": "exchange",
     "to": "ai/npc/BlackMarketeerOfMammon/31092-03.html",
