  "Q00060_GoodWorksReward/31092-02.html": {
   "file": "Q00060_GoodWorksReward/31092-02.html",
   "quest": 60,
   "text": "Black Marketeer of Mammon: You haven't chosen your class yet. Allow me to help you select one. Would this be a sufficient reward for your trouble? Forget the details. Do you like it?",
   "header": "Black Marketeer of Mammon",
   "links": [
    {
     "text": "\"What about my money?\"",
     "bypass": "Quest Q00060_GoodWorksReward REPLY_2",
