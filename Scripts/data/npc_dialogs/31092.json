  "Q00060_GoodWorksReward/31092-03.html": {
   "file": "Q00060_GoodWorksReward/31092-03.html",
   "quest": 60,
   "text": "Black Marketeer of Mammon: Hmmm... You are already taking a test. Would you care to accept part of the money you spent? In lieu of the remainder, I'll give you what you want.",
   "header": "Black Marketeer of Mammon",
   "links": [
    {
     "text": "\"Why are you giving me only part of the money?\"",
     "bypass": "Quest Q00060_GoodWorksReward REPLY_3",
     "kind": "quest-event",
     "script": "Q00060_GoodWorksReward",
