 "pages": {
  "default/32550.htm": {
   "file": "default/32550.htm",
   "quest": null,
   "text": "Kutran: Yes, the scenery here is always fantastic. I collect special items that are only found within the different seeds. If you have a special item, bring it to me and I'll exchange it for something suitable.",
   "header": "Kutran",
   "links": [
    {
     "text": "Special Product Exchange",
