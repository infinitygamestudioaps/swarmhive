     "script": "Q00663_SeductiveWhispers",
     "event": "30846-06.html",
     "quest": 663,
     "to": "Q00663_SeductiveWhispers/30846-06.html"
    },
    {
     "text": "\"How do you play the game?\"",
     "bypass": "Quest Q00663_SeductiveWhispers 30846-07.html",
