  "common/skill_enchant_help_02.htm": {
   "file": "common/skill_enchant_help_02.htm",
   "quest": null,
   "text": "Back in the day, Skill Enchanting was a tedious process that could only be done through specific people throughout the land. But those days are gone. Now all you have to do is open your skill window and click on the Skill Enchanting button at the bottom. How easy is that!",
   "outcome": "dead-end",
   "links": []
  },
