  "trainer/30846-noteach.htm": {
   "file": "trainer/30846-noteach.htm",
   "quest": null,
   "text": "Blacksmith Wilbert: Mere desire to learn does not entitle you to an education. This is a skills on which the livelihood of all Dwarves depends. Besides, you haven't even learned the basic skills required to begin studies here! You must go and learn the basics! (Skill reserved for Dwarven Warsmiths …",
   "header": "Blacksmith Wilbert",
   "outcome": "dead-end",
   "links": []
  },
  "Q00663_SeductiveWhispers/30846-02.html": {
   "file": "Q00663_SeductiveWhispers/30846-02.html",
   "quest": 663,
   "text": "Wilbert: Hey there! Yeah, you, traveler! When you're a little less green, come see me for some excitement you won't soon forget. (Only characters level 50 and above are permitted to take on this quest.)",
   "header": "Wilbert",
   "when": [
    "state CREATED; player.getLevel() < MIN_LEVEL"
   ],
   "outcome": "refusal",
   "links": []
  },
  "Q00663_SeductiveWhispers/30846-01.htm": {
   "file": "Q00663_SeductiveWhispers/30846-01.htm",
   "quest": 663,
   "text": "Wilbert: Hey, you, traveler! Come over here, my friend. You look a little bored. Not sure how what to do with yourself? How about we play a little game that's pretty popular in these parts? I think you'll enjoy it.",
   "header": "Wilbert",
   "when": [
    "state CREATED; NOT player.getLevel() < MIN_LEVEL"
   ],
   "links": [
    {
     "text": "\"What's the game?\"",
     "bypass": "Quest Q00663_SeductiveWhispers 30846-01a.htm",
     "kind": "quest-event",
     "script": "Q00663_SeductiveWhispers",
     "event": "30846-01a.htm",
