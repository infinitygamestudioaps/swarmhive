     "toAll": [
      "Q00663_SeductiveWhispers/30846-22.html",
      "Q00663_SeductiveWhispers/30846-22a.html"
     ]
    },
    {
     "text": "\"I want to play.\" (Requires 50 Spirit Beads)",
     "bypass": "Quest Q00663_SeductiveWhispers 30846-09.html",
     "kind": "quest-event",
     "script": "Q00663_SeductiveWhispers",
     "event": "30846-09.html",
