  "Q00708_PathToBecomingALordGludio/35100-01.htm": {
   "file": "Q00708_PathToBecomingALordGludio/35100-01.htm",
   "quest": 708,
   "text": "Chamberlain Saius: My lord, Gludio may be a barren land, but it deserves a noble ruler. Its people want only a wise lord who will govern well.",
   "header": "Chamberlain Saius",
   "when": [
    "state CREATED; npc.isMyLord(player); !npc.isDominionOfLord(GLUDIO_ID)"
   ],
   "links": [
    {
     "text": "\"Do you think I can be that ruler?\"",
