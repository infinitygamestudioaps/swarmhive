  "Q00504_CompetitionForTheBanditStronghold/35437-07.html": {
   "file": "Q00504_CompetitionForTheBanditStronghold/35437-07.html",
   "quest": 504,
   "text": "Messenger: Did you think that we would allow you to use our land for nothing? Tell you what, there are some Tarlk bugbears raising basilisks that have been bothering us. I'll let you participate in the tryouts if you go and kill some.",
   "header": "Messenger",
   "when": [
    "state STARTED; BANDIT_STRONGHOLD.isWaitingBattle(); !((clan == null) || (clan.getLevel() < 4)); player.isClanLeader(); !((clan.getHideoutId() > 0) || (clan.getFortId() > 0) || (clan.getCastleId() > 0))"
   ],
   "outcome": "dead-end",
   "links": []
  },
  "Q00504_CompetitionForTheBanditStronghold/35437-08.html": {
   "file": "Q00504_CompetitionForTheBanditStronghold/35437-08.html",
   "quest": 504,
   "text": "Messenger: I see that you have brought 30 Tarlk Amulets. Good job! But don't get your hopes up, the competition is fierce now. This clan hall siege will be a close match and should prove to be quite interesting... The final round will begin soon. Hurry and register. Remember, only five clans are al…",
   "header": "Messenger",
   "when": [
    "state STARTED; BANDIT_STRONGHOLD.isWaitingBattle(); !((clan == null) || (clan.getLevel() < 4)); player.isClanLeader(); !((clan.getHideoutId() > 0) || (clan.getFortId() > 0) || (clan.getCastleId() > 0))"
   ],
   "links": [
    {
     "text": "Test to qualify for participation in the clan hall siege.",
     "bypass": "Quest BanditStrongHold register_clan wQuest",
     "kind": "quest-event",
     "script": "BanditStrongHold",
     "event": "register_clan wQuest"
    }
   ]
  },
  "Q00504_CompetitionForTheBanditStronghold/35437-07a.html": {
   "file": "Q00504_CompetitionForTheBanditStronghold/35437-07a.html",
   "quest": 504,
   "text": "Messenger: What are you babbling about? If you already have a certificate to participate in the siege, go ahead and register!",
   "header": "Messenger",
   "when": [
    "state COMPLETED; BANDIT_STRONGHOLD.isWaitingBattle(); !((clan == null) || (clan.getLevel() < 4)); player.isClanLeader(); !((clan.getHideoutId() > 0) || (clan.getFortId() > 0) || (clan.getCastleId() > 0))"
   ],
   "outcome": "dead-end",
   "links": []
