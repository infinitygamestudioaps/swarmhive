 "pages": {
  "default/32757.htm": {
   "file": "default/32757.htm",
   "quest": null,
   "text": "Greymore: Ahh!? Hey, you trying to scare me??",
   "header": "Greymore",
   "links": [
    {
     "text": "Quest",
     "bypass": "npc_%objectId%_Quest",
